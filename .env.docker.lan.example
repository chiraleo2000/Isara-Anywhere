# ============================================================================
# IZARA — Docker Compose + Nginx LAN HTTP (EXAMPLE)
# ============================================================================
# Mode B — HTTP on port 80 (no TLS). For HTTPS use .env.docker.lan.https.example
#
#   cp .env.docker.lan.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Nginx: deploy/nginx/isara-nginx-http.conf (see deploy/nginx/DEPLOYMENT.md)
# Guide: deploy/nginx/DEPLOYMENT.md
# ============================================================================

# --- Application ---
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production
NODE_ENV=production

# --- Database ---
# Persist Postgres on the Ubuntu host (create dir first: sudo mkdir -p /var/lib/izara/postgres && sudo chown 999:999 /var/lib/izara/postgres)
POSTGRES_DATA_DIR=/var/lib/izara/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=izara_phase1
# Expose Postgres on LAN for pgAdmin 4 desktop (Windows/Mac). Omit on dev laptops (defaults to 127.0.0.1:5433).
POSTGRES_PUBLISH=5433
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/izara_phase1
DB_HOST=postgres
DB_PORT=5432
USE_POSTGRESQL=true

# --- Security ---
JWT_SECRET=izara-jwt-secret-key-phase1-2026-min-32-chars
RECORDING_ENCRYPTION_KEY=izara-recording-encryption-key-phase1-2026
JIBRI_WEBHOOK_SECRET=izara-jibri-dev-secret-32chars-min

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# --- OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
OAUTH_REDIRECT_URI=http://patient.demotoday.net/auth/callback

# --- LAN browser URLs (HTTP) ---
VITE_API_URL=
VITE_AUTH_PORTAL_URL=http://patient.demotoday.net/auth
VITE_PATIENT_URL=http://patient.demotoday.net/home
VITE_WEBSOCKET_URL=ws://patient.demotoday.net/ws
VITE_AUTH_URL=

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_MEET_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY

# --- Gemini ---
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# --- Meeting ---
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=http://meeting.demotoday.net
CORS_ORIGINS=http://patient.demotoday.net,http://doctor.demotoday.net,http://meeting.demotoday.net,http://dbadmin.demotoday.net,http://localhost:3005,http://localhost:3010,http://localhost:3020

# --- Jitsi ---
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
JITSI_APP_ID=izara-telemedicine

# --- Feature flags ---
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_VIDEO_CONSULTATION_ENABLED=true

USE_POSTGRESQL=true
E2E_ALLOW_PARALLEL_SESSIONS=1
RATE_LIMIT_MAX=2000
