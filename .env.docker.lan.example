# ============================================================================
# IZARA — Docker Compose + Nginx LAN HTTP (EXAMPLE)
# ============================================================================
# Mode B — HTTP on port 80 (no TLS). For HTTPS use .env.docker.lan.https.example
#
#   cp .env.docker.lan.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Nginx: deploy/nginx/isara-system.conf
# Guide: deploy/nginx/LOCAL_DOCKER_DEPLOYMENT.md
# Manual: deploy/nginx/UBUNTU_MANUAL_REDEPLOY.txt
# ============================================================================

# --- Application ---
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production
NODE_ENV=production

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=izara_phase1
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/izara_phase1
DB_HOST=postgres
DB_PORT=5432
USE_POSTGRESQL=true

# --- Security ---
JWT_SECRET=izara-jwt-secret-key-phase1-2026-min-32-chars
RECORDING_ENCRYPTION_KEY=izara-recording-encryption-key-phase1-2026
JIBRI_WEBHOOK_SECRET=izara-jibri-dev-secret-32chars-min

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# --- OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
VITE_OAUTH_REDIRECT_URI=http://patient.isara.local/auth/callback

# --- LAN browser URLs (HTTP) ---
VITE_API_URL=
VITE_AUTH_PORTAL_URL=http://patient.isara.local/auth
VITE_PATIENT_URL=http://patient.isara.local/home
VITE_WEBSOCKET_URL=ws://patient.isara.local/ws
VITE_AUTH_URL=

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
VITE_GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_API_KEY
VITE_GOOGLE_MEET_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY

# --- Gemini ---
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# --- Meeting ---
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=http://meeting.isara.local
CORS_ORIGINS=http://patient.isara.local,http://doctor.isara.local,http://meeting.isara.local,http://dbadmin.isara.local,http://localhost:3005,http://localhost:3010,http://localhost:3020

# --- Jitsi ---
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
VITE_JITSI_APP_ID=izara-telemedicine

# --- Feature flags ---
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_VIDEO_CONSULTATION_ENABLED=true

USE_POSTGRESQL=true
E2E_ALLOW_PARALLEL_SESSIONS=1
RATE_LIMIT_MAX=2000
