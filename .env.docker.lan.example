# ============================================================================
# IZARA — Docker Compose + Nginx LAN subdomains (EXAMPLE)
# ============================================================================
# Copy to .env.docker on your Ubuntu server when using Nginx reverse proxy
# so Windows / other PCs on the LAN can open patient.isara.local etc.
#
#   cp .env.docker.lan.example .env.docker
#   # edit passwords and API keys, then:
#   docker compose up -d --build
#
# See: deploy/nginx/LOCAL_DOCKER_DEPLOYMENT.md
# ============================================================================

# --- Database (same as .env.docker.example) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword

# --- Security ---
JWT_SECRET=replace-with-openssl-rand-hex-32-min-32-chars
RECORDING_ENCRYPTION_KEY=replace-with-32-char-minimum-secret-key
JIBRI_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# --- AI (xxxxx = disabled until real key) ---
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# --- Google APIs (optional for maps / SSO) ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY

# --- JITSI ---
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
VITE_JITSI_APP_ID=izara-telemedicine

# --- LAN subdomain URLs (browser-facing — MUST match Nginx server_name) ---
# Internal Docker traffic still uses meeting-server:3020 via MEETING_SERVER_URL.
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=http://meeting.isara.local

# CORS — explicit LAN origins (optional; shared/corsPolicy.cjs also allows *.isara.local)
CORS_ORIGINS=http://patient.isara.local,http://doctor.isara.local,http://meeting.isara.local,http://dbadmin.isara.local,http://localhost:3005,http://localhost:3010,http://localhost:3020

# Doctor portal build — leave empty for same-origin relative API paths
VITE_AUTH_URL=

USE_POSTGRESQL=true
