    <mxCell id="p1_db_tables" value="appointments · users · emr · prescriptions · lab_orders · meeting_records · meeting_transcripts · phr · vital_signs&#xa;patient_profiles · notifications · sessions · cds_logs · ai_validations · knowledge_base · audit_logs · prescriptions" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#7d6600;" vertex="1" parent="1">
