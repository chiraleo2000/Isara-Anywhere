    <!-- PAGE 1: SYSTEM OVERVIEW                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- BG -->
    <mxCell id="p1_title" value="Isara Anywhere — Platform Architecture Overview" style="text;html=1;strokeColor=none;fillColor=#1a1a2e;fontColor=#FFFFFF;align=center;fontSize=18;fontStyle=1;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1100" height="44" as="geometry" />
    </mxCell>

    <!-- Patient Portal Box -->
    <mxCell id="p1_pp" value="🏥 Patient Portal&#xa;Port 3005 | React + Express&#xa;15 Pages" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="80" y="100" width="280" height="260" as="geometry" />
    </mxCell>
    <mxCell id="p1_pp_pages" value="• Login / Register / Reset Password&#xa;• Dashboard (Hub)&#xa;• Appointments (Book/View)&#xa;• PHR – Personal Health Records&#xa;• AI Doctor Chat&#xa;• Health Library&#xa;• Map (Google Maps)&#xa;• PDPA Consent&#xa;• Living Will (4-step)&#xa;• Profile / Settings&#xa;• Timeline (Treatment History)&#xa;• Notification Bell (Real-Time)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="88" y="148" width="264" height="200" as="geometry" />
    </mxCell>

    <!-- Doctor Portal Box -->
    <mxCell id="p1_dp" value="🩺 Doctor Portal&#xa;Port 3010 | React + Express&#xa;21 Pages + Modals" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="420" y="100" width="310" height="320" as="geometry" />
    </mxCell>
    <mxCell id="p1_dp_pages" value="• Login / Reset Password&#xa;• Dashboard (Stats + AI)&#xa;• Schedule (Calendar)&#xa;• Patient Management&#xa;• Health Meeting (Video Console)&#xa;  └ Virtual Meeting (Jitsi Modal)&#xa;  └ EMR Editor (SOAP Modal)&#xa;  └ E-Prescribing Modal&#xa;  └ Lab Orders Modal&#xa;  └ Patient Record Viewer&#xa;• Medical Consultants&#xa;• Clinical Resources + RAG&#xa;• Medical Content Management&#xa;• Gemini AI Studio (FAB)&#xa;• Appointment Pool&#xa;• Admin: Doctor Management&#xa;• Admin: Appointments Mgmt" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="428" y="148" width="294" height="260" as="geometry" />
    </mxCell>

    <!-- Meeting Server Box -->
    <mxCell id="p1_ms" value="🎥 Meeting Server&#xa;Port 3020 | Express + Socket.IO" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="800" y="100" width="260" height="200" as="geometry" />
    </mxCell>
    <mxCell id="p1_ms_features" value="• Jitsi Room Management&#xa;• Transcript Streaming (Web Speech)&#xa;• AI Summary (Gemini 2.5)&#xa;• Recording → PostgreSQL BYTEA&#xa;• Socket.IO Real-Time Events&#xa;• Lobby Admission Control&#xa;• Guest Token Validation" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="808" y="148" width="244" height="140" as="geometry" />
    </mxCell>

    <!-- PostgreSQL -->
    <mxCell id="p1_db" value="🗄️ PostgreSQL 18 + pgvector  |  Database: izara_phase1  |  42 Tables" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="380" y="480" width="430" height="80" as="geometry" />
