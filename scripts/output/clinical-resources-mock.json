        "GLP-1 RA for weight management"
      ],
      "quickReference": {
        "hba1cTargets": {
          "general": "<7%",
          "elderly_comorbid": "<8%",
          "pregnancy": "<6.5%"
        },
        "medications": [
          {
            "class": "Biguanide",
            "example": "Metformin",
            "notes": "First-line. Reduce if eGFR 30-45, stop if <30"
          },
          {
            "class": "SGLT2 inhibitor",
            "example": "Empagliflozin, Dapagliflozin",
            "notes": "Add for CKD or heart failure. Renoprotective."
          },
          {
            "class": "GLP-1 RA",
            "example": "Liraglutide, Semaglutide",
            "notes": "Weight reduction. Injectable or oral."
          },
          {
            "class": "Sulfonylurea",
            "example": "Glipizide, Glimepiride",
            "notes": "Hypoglycemia risk. Start low dose."
          }
        ]
      }
