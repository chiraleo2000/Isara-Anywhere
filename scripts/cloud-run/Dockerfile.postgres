# PostgreSQL with pgvector for Cloud Run
# Data initialized from seed file on startup
# Same architecture as local Docker container
# Version: 1.2.0 - Updated to use stable pgvector tag

FROM pgvector/pgvector:pg18

# Set environment variables
# NOTE: Password should be overridden at runtime via -e POSTGRES_PASSWORD
ENV POSTGRES_USER=${POSTGRES_USER:-postgres}
ARG POSTGRES_PASSWORD
ENV POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-changeme}
ENV POSTGRES_DB=izara_phase1
ENV PGDATA=/var/lib/postgresql/data

# Install additional packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy initialization SQL from init-scripts folder
COPY init-scripts/ /docker-entrypoint-initdb.d/

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pg_isready -U postgres -d izara_phase1 || exit 1

EXPOSE 5432

# Use default postgres entrypoint
CMD ["postgres"]
