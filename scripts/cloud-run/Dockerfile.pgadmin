# pgAdmin for Cloud Run
# Version: 1.1.0 - Security hardened

FROM dpage/pgadmin4:8.14

# Set environment variables
# NOTE: Password should be overridden at runtime via -e PGADMIN_DEFAULT_PASSWORD
ENV PGADMIN_DEFAULT_EMAIL=${PGADMIN_EMAIL:-admin@izara.com}
ARG PGADMIN_PASSWORD
ENV PGADMIN_DEFAULT_PASSWORD=${PGADMIN_PASSWORD:-changeme}
ENV PGADMIN_LISTEN_PORT=8080
ENV PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=False
ENV PGADMIN_CONFIG_WTF_CSRF_ENABLED=False

# Pre-configure server connection
COPY servers.json /pgadmin4/servers.json

EXPOSE 8080

# Use default pgadmin entrypoint
