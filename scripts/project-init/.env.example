# ============================================================================
# IZARA TELEMEDICINE PLATFORM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control!
# ============================================================================

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================

# GCP Project ID
GCP_PROJECT_ID=your-project-id

# GCP Region for Cloud Run deployment
GCP_REGION=asia-southeast1

# Path to service account key file (for local development)
# Leave empty if using Application Default Credentials or Workload Identity
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ============================================================================
# GCS BUCKET NAMES
# ============================================================================

# User credentials bucket (auth data)
GCS_BUCKET_AUTH=your-project-users-credentials

# Patient data bucket
GCS_BUCKET_PATIENT=your-project-patients-data

# Doctor data bucket
GCS_BUCKET_DOCTOR=your-project-doctors-data

# Appointments bucket
GCS_BUCKET_APPOINTMENTS=your-project-appointments

# Metadata bucket (system configuration, content, etc.)
GCS_BUCKET_METADATA=your-project-meta-data

# ============================================================================
# GCS API SERVER (Internal)
# ============================================================================

# GCS API Server URL (for seeding scripts)
GCS_API_URL=http://localhost:3012

# GCS API Server Port
GCS_API_PORT=3012

# ============================================================================
# PORTAL CONFIGURATION
# ============================================================================

# Patient Portal
PATIENT_PORTAL_PORT=3005
PATIENT_API_PORT=3004
VITE_API_BASE_URL=http://localhost:3004

# Doctor Portal  
DOCTOR_PORTAL_PORT=3010
DOCTOR_API_PORT=3009
DOCTOR_AUTH_PORT=3011

# ============================================================================
# ADMIN ACCOUNT CONFIGURATION
# ============================================================================

# Default Admin User (used during initialization)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecurePassword@2024
ADMIN_NAME=System Administrator

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret Key (generate a strong random key)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# JWT Token Expiry (in seconds)
JWT_EXPIRY=86400

# ============================================================================
# GOOGLE OAUTH (Optional)
# ============================================================================

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Jitsi Server URL for video meetings
VITE_JITSI_SERVER=https://meet.jit.si

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================

# Environment: development, staging, production
NODE_ENV=development

# Enable debug logging
DEBUG=true

# Log Level: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Rate limiting (requests per 15 min window)
RATE_LIMIT_MAX=300

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3005,http://localhost:3010

# ============================================================================
# CLOUD RUN DEPLOYMENT (Production)
# ============================================================================

# Artifact Registry
ARTIFACT_REGISTRY=asia-southeast1-docker.pkg.dev

# Docker image repository
DOCKER_REPOSITORY=your-project-id/your-repo-name

# Cloud Run service names
PATIENT_SERVICE_NAME=patient-portal
DOCTOR_SERVICE_NAME=doctor-portal

# Cloud Run configuration
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=10
