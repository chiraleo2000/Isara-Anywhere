{
  "name": "issara-workspace",
  "version": "1.7.61",
  "private": true,
  "description": "ISSARA Workspace - Run all projects concurrently",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"JITSI,PATIENT,DOCTOR\" --prefix-colors \"blue,green,magenta\" --prefix \"[{name}]\" --kill-others-on-fail \"npm run dev:jitsi\" \"npm run dev:patient\" \"npm run dev:doctor\"",
    "dev:jitsi": "cd ../issara-jitsi && npm run dev",
    "dev:patient": "cd ../issara-patient && npm run dev:all",
    "dev:doctor": "cd ../issara-doctor && npm run dev",
    "install:all": "cd ../issara-jitsi && npm install && cd ../issara-patient && npm install && cd ../issara-doctor && npm install",
    "env:sync": "node scripts/env/sync-portal-env.mjs",
    "env:sync:dry": "node scripts/env/sync-portal-env.mjs --dry-run",
    "env:audit": "node scripts/env/audit-doctor-portal-env.mjs",
    "verify:deps": "node -e \"const fs=require('fs');const p=['tests/unit/node_modules','issara-patient/package.json','issara-doctor/package.json','issara-jitsi/package.json'];for(const x of p){if(!fs.existsSync(x)){console.error('missing',x);process.exit(1)}}console.log('verify:deps ok')\"",
    "verify:gate0": "node scripts/verify-cloud-appointment-sync.mjs",
    "verify:gate0:local": "cross-env PATIENT_URL=http://127.0.0.1:3005 DOCTOR_URL=http://127.0.0.1:3010 MEETING_URL=http://127.0.0.1:3020 node scripts/verify-cloud-appointment-sync.mjs",
    "verify:cloud-meeting-ai": "node scripts/verify-cloud-meeting-ai.mjs",
    "test:unit": "npm --prefix tests/unit test",
    "test:unit:ui": "npm --prefix tests/unit run test:ui",
    "test:unit:coverage": "npm --prefix tests/unit run test:coverage",
    "test:unit:coverage:gate": "node scripts/run-unit-coverage-gate.mjs",
    "test:unit:auth": "npm --prefix tests/unit run test:auth",
    "test:unit:appointments": "npm --prefix tests/unit run test:appointments",
    "test:unit:clinical": "npm --prefix tests/unit run test:clinical",
    "test:unit:meeting": "npm --prefix tests/unit run test:meeting",
    "test:unit:ai": "npm --prefix tests/unit run test:ai",
    "test:unit:api": "npm --prefix tests/unit run test:api",
    "test:unit:database": "npm --prefix tests/unit run test:database",
    "test:unit:workflows": "npm --prefix tests/unit run test:workflows",
    "test:unit:security": "npm --prefix tests/unit run test:security",
    "test:unit:notifications": "npm --prefix tests/unit run test:notifications",
    "test:unit:content": "npm --prefix tests/unit run test:content",
    "test:unit:admin": "npm --prefix tests/unit run test:admin",
    "test:unit:meeting-acceptance": "npm --prefix tests/unit exec -- vitest run meeting-server/joinConfigAcceptance.test.ts meeting-server/meetingCreateAcceptance.test.ts meeting-server/hostReadyGate.test.ts meeting-server/lobbyKeyResolve.test.ts meeting-server/meetingRuntimeApi.test.ts meeting-server/jibriWebhook.test.ts cross-portal/jitsiMeetingConfig.test.ts",
    "test:unit:process-contracts": "npm --prefix tests/unit exec -- vitest run cross-portal/processPageCoverage.test.ts cross-portal/processDocContentContract.test.ts cross-portal/pageWorkflowCoverageContract.test.ts cross-portal/pageElementContract.test.ts cross-portal/workflowContract.test.ts cross-portal/fullWorkflowInvariants.test.ts cross-portal/appointmentWorkflowContract.test.ts cross-portal/healthRecordsWorkflowContract.test.ts cross-portal/workflowConnectionsContract.test.ts cross-portal/combinedWorkflowActions.test.ts cross-portal/separatedWorkflowFunctions.test.ts cross-portal/siblingLayoutContract.test.ts doctor-portal/processPagesContract.test.ts patient-portal/processPagesContract.test.ts \"**/*Contract*.test.ts\"",
    "test:unit:v5-contracts": "npm --prefix tests/unit exec -- vitest run cross-portal/phase1RequirementsContract.test.ts cross-portal/gate0ImplementationContract.test.ts cross-portal/fullWorkflowInvariants.test.ts cross-portal/workflowContract.test.ts cross-portal/twoRoundCloudTestingContract.test.ts cross-portal/securityScanningContract.test.ts cross-portal/siblingLayoutContract.test.ts",
    "test:unit:report": "node scripts/aggregate-unit-test-report.mjs",
    "test:unit:groups-sequential": "node scripts/run-unit-groups-sequential.mjs",
    "test:unit:docker": "node scripts/docker/run-unit-tests.mjs",
    "test:unit:docker:coverage": "node scripts/docker/run-unit-tests.mjs --coverage",
    "test:unit:docker:grouped": "node scripts/docker/run-unit-tests-grouped.mjs",
    "test:unit:docker:deploy": "node scripts/docker/deploy-and-test.mjs",
    "test:meeting-server:contract": "npm --prefix tests/unit run test:meeting-server",
    "test:security-hardening": "npm --prefix tests/unit exec -- vitest run security/ doctor-portal/meetingWorkflowHardening.test.ts cross-portal/securityScanningContract.test.ts",
    "test:post-meeting-pipeline": "npm --prefix tests/unit exec -- vitest run cross-portal/postMeetingWorkflow.integration.test.ts meeting-server/generateSummary.integration.test.ts meeting-server/recordingRoundTrip.integration.test.ts",
    "test:guards:static": "node scripts/guards/run-static-guards.mjs",
    "test:lint:portals": "npm run test:lint:portals:full",
    "test:lint:portals:full": "node scripts/lint/eslint.deep-scan.cjs --portal=doctor && node scripts/lint/eslint.deep-scan.cjs --portal=patient && node scripts/lint/eslint.deep-scan.jitsi.cjs",
    "lint:portals:full": "npm run test:lint:portals:full",
    "test:audit:process": "python scripts/audit-process-coverage.py",
    "test:quality:gate": "npm run sonar:lint",
    "sonar:lint": "node scripts/sonar/run-quality-gate.mjs",
    "security:scan": "node scripts/security/run-security-scan.mjs",
    "security:app-scan": "node scripts/security/app-security-scan.mjs",
    "security:cve-lite": "node scripts/security/run-cve-lite-scan.mjs",
    "security:cve-lite:report": "node scripts/security/run-cve-lite-scan.mjs --report",
    "audit:prod": "npm audit --omit=dev --prefix ../issara-patient && npm audit --omit=dev --prefix ../issara-doctor && npm audit --omit=dev --prefix ../issara-jitsi",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "cross-env PW_HEADED=1 playwright test --config=playwright.config.ts --headed",
    "test:e2e:auth": "cross-env PW_HEADED=1 playwright test --config=playwright.config.ts --project=A-auth --headed",
    "test:e2e:ui-showup": "cross-env PW_HEADED=1 BASELINE_VISUAL=1 playwright test --config=playwright.config.ts --project=A-auth --project=B-patient-portal --project=C-doctor-portal --headed",
    "test:local:e2e-full": "cross-env PW_HEADED=1 BASELINE_VISUAL=1 PW_SKIP_LIVE_GEMINI=1 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-coverage.ps1 -Headed -Workers 1",
    "test:local:e2e-parallel": "cross-env PW_HEADED=1 BASELINE_VISUAL=1 PW_SKIP_LIVE_GEMINI=1 GATE_PARALLEL=1 PW_WORKERS=2 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-coverage.ps1 -Headed -Workers 2",
    "test:local:e2e-strict": "cross-env GATE_STRICT=1 PW_HEADED=1 BASELINE_VISUAL=1 PW_SKIP_LIVE_GEMINI=1 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-coverage.ps1 -Headed -Workers 1",
    "test:local:e2e-strict-parallel": "cross-env GATE_STRICT=1 GATE_PARALLEL=1 PW_HEADED=1 BASELINE_VISUAL=1 PW_SKIP_LIVE_GEMINI=1 PW_WORKERS=1 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-coverage.ps1 -Headed -Workers 1",
    "test:e2e:docker:core-multibrowser": "node scripts/docker/run-e2e-core-multibrowser.mjs",
    "test:e2e:docker:jitsi-roles": "node scripts/docker/run-e2e-jitsi-roles.mjs",
    "test:e2e:docker:meeting-lifecycle": "node scripts/docker/run-e2e-meeting-lifecycle.mjs",
    "test:e2e:docker:queue-traceability": "node scripts/docker/run-e2e-queue-traceability.mjs",
    "test:e2e:docker:patient-jitsi-prejoin": "node scripts/docker/run-e2e-patient-jitsi-prejoin.mjs",
    "test:local:pre-deploy-gate": "node scripts/run-local-pre-deploy-gate.mjs",
    "test:local:gate-parallel-resume": "cross-env GATE_PARALLEL=1 node scripts/run-local-pre-deploy-gate.mjs",
    "test:cross-browser:gate": "node scripts/run-cross-browser-gate.mjs",
    "test:gate:ui-showup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-gate-ui-showup.ps1",
    "gate:triage": "node scripts/gates/triage-gate-failure.mjs",
    "phase:0": "node scripts/gates/phase-0-structure.mjs",
    "phase:1": "node scripts/gates/phase-1-foundation.mjs",
    "phase:2": "node scripts/gates/phase-2-auth.mjs",
    "phase:3": "node scripts/gates/phase-3-post-meeting.mjs",
    "phase:4": "node scripts/gates/phase-4-live-meeting.mjs",
    "phase:5": "node scripts/gates/phase-5-appointments.mjs",
    "phase:6": "node scripts/gates/phase-6-patient-ui.mjs",
    "phase:7": "node scripts/gates/phase-7-clinical.mjs",
    "phase:8": "node scripts/gates/phase-8-regression.mjs",
    "phase:9": "node scripts/gates/phase-9-full.mjs",
    "phase:9:strict": "cross-env GATE_STRICT=1 node scripts/gates/phase-9-full.mjs",
    "phase:9:parallel": "node scripts/gates/phase-9-parallel.mjs",
    "test:screenshots:all": "node scripts/validate-screenshot-uniqueness.mjs --group group-A,group-B,group-C,group-D,group-E,group-F,group-G,group-H,group-I,group-J,group-J-jitsi-prejoin,group-L,group-Q,group-Q2,group-R,group-S,group-defect",
    "test:screenshots:group-e": "node scripts/validate-screenshot-uniqueness.mjs --group group-E",
    "test:screenshots:group-s": "node scripts/validate-screenshot-uniqueness.mjs --group group-S",
    "test:screenshots:group-q2": "node scripts/validate-screenshot-uniqueness.mjs --group group-Q2",
    "test:screenshots:group-q": "node scripts/validate-screenshot-uniqueness.mjs --group group-Q",
    "test:screenshots:group-w": "node scripts/validate-screenshot-uniqueness.mjs --group group-W",
    "test:screenshots:group-d": "node scripts/validate-screenshot-uniqueness.mjs --group group-D",
    "test:screenshots:global": "node scripts/validate-screenshot-global.mjs",
    "docs:sync-screenshots": "node scripts/docs/sync-e2e-screenshots.mjs",
    "docs:evidence:local": "npm run docs:sync-screenshots && node scripts/docs/update-runbook-test-evidence.mjs --env local",
    "docs:evidence:cloud": "npm run docs:sync-screenshots && node scripts/docs/update-runbook-test-evidence.mjs --env cloud",
    "docs:sync-to-apps": "node scripts/docs/sync-to-apps.mjs",
    "cloud:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloud-from-env.ps1",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "cloud:migrate": "node scripts/apply-cloud-db-from-env.cjs",
    "cloud:sync-meeting-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cloud-run/sync-meeting-ai-secrets.ps1",
    "test:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-tests.ps1",
    "test:cloud:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-full-coverage.ps1",
    "test:cloud:hardening": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-two-round-cloud-hardening.ps1",
    "test:cloud:deploy-gate": "npm run cloud:smoke && npm run verify:gate0 && npm run verify:cloud-meeting-ai && cross-env TEST_ENV=cloud PW_HEADED=1 playwright test --project=A-auth --project=D-appointments --project=Q-meeting-lifecycle --headed",
    "ledger:cloud": "node scripts/aggregate-cloud-error-ledger.mjs",
    "ledger:local": "cross-env TEST_ENV=local node scripts/aggregate-cloud-error-ledger.mjs",
    "ledger:pre-debug": "node scripts/aggregate-pre-debug-baseline.mjs",
    "cleanup:cloud-test-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cloud-test-data.ps1",
    "cleanup:cloud-test": "npm run cleanup:cloud-test-only",
    "cleanup:local-test-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-local-test-data.ps1",
    "cleanup:project": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-project.ps1",
    "cleanup:project:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-project.ps1 -DryRun",
    "cleanup:artifacts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-project.ps1 -ArtifactsOnly",
    "docker:probe-health": "node scripts/docker/probe-health.mjs",
    "docker:meeting-api-smoke": "node scripts/docker/meeting-api-smoke.mjs",
    "multitask:ports": "node scripts/multitask/verify-ports.mjs",
    "seed": "node scripts/database/db-tool.cjs --seed",
    "db:bundle:apps": "node scripts/database/bundle-apps.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.52.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "zod": "^4.4.3"
  }
}
