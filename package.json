{
  "name": "isara-anywhere",
  "version": "1.7.48",
  "description": "Izara Telemedicine Platform - Patient and Doctor Portals",
  "main": "index.js",
  "scripts": {
    "test": "cd tests/unit && npm test",
    "test:unit": "cd tests/unit && npm test",
    "test:unit:watch": "cd tests/unit && npm run test:watch",
    "test:unit:coverage": "cd tests/unit && npm run test:coverage",
    "test:unit:report": "node scripts/aggregate-unit-test-report.mjs",
    "test:unit:auth": "cd tests/unit && npm run test:auth",
    "test:unit:appointments": "cd tests/unit && npm run test:appointments",
    "test:unit:clinical": "cd tests/unit && npm run test:clinical",
    "test:unit:meeting": "cd tests/unit && npm run test:meeting",
    "test:unit:ai": "cd tests/unit && npm run test:ai",
    "test:unit:security": "cd tests/unit && npm run test:security",
    "test:unit:api": "cd tests/unit && npm run test:api",
    "test:unit:notifications": "cd tests/unit && npm run test:notifications",
    "test:e2e": "npx playwright test",
    "test:e2e:full": "npx playwright test",
    "test:e2e:parallel": "npx playwright test --project=B-patient-portal --project=C-doctor-portal --project=G-livingwill-pdpa --project=H-content-resources --project=I-admin-notifications --project=J-ai-timeline-map",
    "test:e2e:pipeline": "npx playwright test --project=D-appointments --project=D-doctor-host --project=Q-meeting-lifecycle --project=E-meeting-clinical --project=F-phr-health-records --project=L-lab-ordering --workers=1",
    "test:e2e:meeting-lifecycle": "cross-env TEST_ENV=cloud npx playwright test --project=Q-meeting-lifecycle --workers=1",
    "test:unit:wave2": "cd tests/unit && npx vitest run doctor-portal/authServer.http.test.ts doctor-portal/emrAutosave.test.ts doctor-portal/prescribingAllergy.test.ts doctor-portal/queueSocket.test.ts",
    "test:unit:wave3": "cd tests/unit && npx vitest run patient-portal/appointmentSlotLock.test.ts patient-portal/pdpaAudit.integration.test.ts patient-portal/aiTriage.test.ts",
    "test:unit:wave4": "cd tests/unit && npx vitest run patient-portal/appointmentsRollback.test.ts cross-portal/syncQueue.integration.test.ts",
    "test:audit:process": "python scripts/audit-process-coverage.py",
    "test:meeting-server:contract": "node --test Izara-jitsi-server/tests/*.test.mjs",
    "test:post-meeting-pipeline": "node --test Izara-jitsi-server/tests/postMeetingPipeline.test.mjs Izara-jitsi-server/tests/recordingCrypto.test.mjs Izara-jitsi-server/tests/postMeetingPipeline.integration.test.mjs Izara-jitsi-server/tests/postMeetingPipeline.stress.test.mjs",

    "test:post-meeting-pipeline:rounds": "node scripts/archive/deprecated/run-post-meeting-pipeline-rounds.mjs --round=all",
    "test:unit:meeting-acceptance": "cd tests/unit && npx vitest run meeting-server/joinConfigAcceptance.test.ts meeting-server/meetingCreateAcceptance.test.ts meeting-server/hostReadyGate.test.ts meeting-server/lobbyKeyResolve.test.ts meeting-server/meetingRuntimeApi.test.ts meeting-server/jibriWebhook.test.ts cross-portal/jitsiMeetingConfig.test.ts",
    "test:zero-exception": "node scripts/run-zero-exception-suite.mjs",
    "test:security-hardening": "node --test Izara-jitsi-server/tests/recordingAccess.test.mjs Izara-jitsi-server/tests/jwtPolicy.test.mjs Izara-jitsi-server/tests/webhookProdSecret.test.mjs && cd tests/unit && npx vitest run doctor-portal/jwtPolicyAlignment.test.ts patient-portal/malformedBody.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high --prefix Isara-patient-portal && npm audit --omit=dev --audit-level=high --prefix Isara-doctor-portal && npm audit --omit=dev --audit-level=high --prefix Izara-jitsi-server",
    "test:e2e:multi-browser": "npx playwright test --workers=1",
    "test:e2e:meeting-multibrowser": "npx playwright test --project=A-auth --project=D-appointments --project=E-meeting-clinical --workers=1",
    "test:e2e:auth": "npx playwright test --project=A-auth",
    "test:e2e:coverage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-coverage.ps1",
    "test:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-tests.ps1",
    "test:cloud:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-tests.ps1 -Headed",
    "test:cloud:pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-tests.ps1 -Headed --project=D-appointments --project=D-doctor-host --project=Q-meeting-lifecycle --project=E-meeting-clinical --project=F-phr-health-records --project=L-lab-ordering",
    "test:cloud:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-full-coverage.ps1 -SkipHealthGate -Workers 1",
    "test:cloud:hardening": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-two-round-cloud-hardening.ps1 -Round All -Headed",
    "test:cloud:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-cloud-full-coverage.ps1 -Workers 1 -SkipHealthGate",
    "test:baseline:local": "cross-env BASELINE_VISUAL=1 PW_HEADED=1 npx playwright test",
    "test:baseline:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TEST_ENV='cloud'; $env:BASELINE_VISUAL='1'; $env:PW_HEADED='1'; & scripts/run-cloud-tests.ps1\"",
    "test:baseline:responsive": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:BASELINE_VISUAL='1'; $env:PW_HEADED='1'; npx playwright test --project=S-responsive-mobile --project=S-responsive-tablet --project=S-responsive-desktop\"",
    "test:responsive": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:BASELINE_VISUAL='1'; $env:PW_HEADED='1'; npx playwright test --project=S-responsive-mobile --project=S-responsive-tablet --project=S-responsive-desktop\"",
    "test:unit:baseline": "npm run test:unit:auth && npm run test:unit:appointments && npm run test:unit:meeting && npm run test:unit:meeting-acceptance",
    "test:cloud:unit-gate": "npm run test:unit && npm run test:unit:meeting-acceptance && npm run test:security-hardening && npm run test:meeting-server:contract && npm run cloud:smoke && npm run verify:gate0",
    "test:gate:ui-showup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-gate-ui-showup.ps1",
    "test:gate:responsive-cloud": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TEST_ENV='cloud'; $env:BASELINE_VISUAL='1'; $env:PW_HEADED='1'; $env:PW_WORKERS='1'; npx playwright test --project=S-phone-xs --project=S-phone-sm --project=S-phone-md --project=S-phone-lg --project=S-tablet-sm --project=S-tablet-md --project=S-tablet-lg --headed --workers=1\"",
    "verify:deps": "npm ci && cd tests/unit && npm ci && cd ../.. && cd Isara-patient-portal && npm ci && cd ../Isara-doctor-portal && npm ci && cd ../Izara-jitsi-server && npm ci && cd ..",
    "ledger:pre-debug": "node scripts/aggregate-pre-debug-baseline.mjs",
    "security:app-scan": "node scripts/security/app-security-scan.mjs",
    "sonar:lint": "node scripts/sonar/run-quality-gate.mjs",
    "test:quality:gate": "npm run test:unit:coverage && npm run test:security-hardening && npm run test:meeting-server:contract && npm run sonar:lint",
    "test:cloud:hardening:round1": "pwsh scripts/run-two-round-cloud-hardening.ps1 -Round 1",
    "test:cloud:hardening:round2": "pwsh scripts/run-two-round-cloud-hardening.ps1 -Round 2",
    "ledger:cloud": "node scripts/aggregate-cloud-error-ledger.mjs",
    "cleanup:cloud-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cloud-test-data.ps1 -Reseed",
    "cleanup:cloud-test-only": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-cloud-test-data.ps1",
    "cleanup:project": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-project.ps1",
    "cleanup:project:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-project.ps1 -DryRun",
    "guides:cleanup-old": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-old-user-guides.ps1",
    "guides:enrich": "python scripts/enrich-process-pages.py --force-steps",
    "guides:build": "python scripts/build-portal-user-guides.py",
    "guides:technical": "python scripts/build-technical-architecture-docs.py",
    "guides:pdf": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-user-guide-pdf.ps1",
    "guides:drawio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-drawio-png.ps1",
    "diagrams:export": "node scripts/export-diagram-pages-playwright.mjs",
    "diagrams:report": "node scripts/export-diagram-pages-playwright.mjs && python scripts/build-diagram-technical-report.py",
    "guides:all": "npm run guides:cleanup-old && npm run guides:enrich && npm run guides:build && npm run guides:technical && npm run guides:pdf",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "verify:gate0": "node scripts/verify-cloud-appointment-sync.mjs",
    "verify:cloud-meeting-ai": "node scripts/verify-cloud-meeting-ai.mjs",
    "cloud:sync-meeting-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cloud-run/sync-meeting-ai-secrets.ps1",
    "cloud:migrate": "node scripts/apply-cloud-db-from-env.cjs --cloud",
    "cloud:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloud-from-env.ps1",
    "seed": "node scripts/database/db-tool.cjs --seed",
    "seed:all": "node scripts/database/db-tool.cjs --all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.17.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0"
  }
}
