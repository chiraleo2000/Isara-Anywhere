{
  "name": "isara-anywhere",
  "version": "1.7.33",
  "description": "Izara Telemedicine Platform - Patient and Doctor Portals",
  "main": "index.js",
  "scripts": {
    "test": "cd tests/unit && npm test",
    "test:unit": "cd tests/unit && npm test",
    "test:unit:watch": "cd tests/unit && npm run test:watch",
    "test:unit:coverage": "cd tests/unit && npm run test:coverage",
    "test:unit:auth": "cd tests/unit && npm run test:auth",
    "test:unit:appointments": "cd tests/unit && npm run test:appointments",
    "test:unit:clinical": "cd tests/unit && npm run test:clinical",
    "test:unit:meeting": "cd tests/unit && npm run test:meeting",
    "test:unit:ai": "cd tests/unit && npm run test:ai",
    "test:unit:security": "cd tests/unit && npm run test:security",
    "test:unit:api": "cd tests/unit && npm run test:api",
    "test:unit:notifications": "cd tests/unit && npm run test:notifications",
    "test:e2e": "npx playwright test",
    "test:e2e:full": "npx playwright test",
    "test:e2e:parallel": "npx playwright test --project=B-patient-portal --project=C-doctor-portal --project=G-livingwill-pdpa --project=H-content-resources --project=I-admin-notifications --project=J-ai-timeline-map",
    "test:e2e:pipeline": "npx playwright test --project=D-appointments --project=D-doctor-host --project=Q-meeting-lifecycle --project=E-meeting-clinical --project=F-phr-health-records --project=L-lab-ordering --workers=1",
    "test:e2e:meeting-lifecycle": "cross-env TEST_ENV=cloud npx playwright test --project=Q-meeting-lifecycle --workers=1",
    "test:unit:wave2": "cd tests/unit && vitest run doctor-portal/authServer.http.test.ts doctor-portal/emrAutosave.test.ts doctor-portal/prescribingAllergy.test.ts doctor-portal/queueSocket.test.ts",
    "test:unit:wave3": "cd tests/unit && vitest run patient-portal/appointmentSlotLock.test.ts patient-portal/pdpaAudit.integration.test.ts patient-portal/aiTriage.test.ts",
    "test:unit:wave4": "cd tests/unit && vitest run patient-portal/appointmentsRollback.test.ts cross-portal/syncQueue.integration.test.ts",
    "test:audit:process": "python scripts/audit-process-coverage.py",
    "test:meeting-server:contract": "node --test Izara-jitsi-server/tests/*.test.mjs",
    "test:post-meeting-pipeline": "node --test Izara-jitsi-server/tests/postMeetingPipeline.test.mjs Izara-jitsi-server/tests/recordingCrypto.test.mjs Izara-jitsi-server/tests/postMeetingPipeline.integration.test.mjs Izara-jitsi-server/tests/postMeetingPipeline.stress.test.mjs",
    "test:post-meeting-pipeline:rounds": "node scripts/run-post-meeting-pipeline-rounds.mjs --round=all",
    "test:round2-chaos": "node scripts/run-round2-chaos.mjs",
    "test:round3-diagnostics": "node scripts/run-round3-diagnostics.mjs",
    "test:unit:meeting-acceptance": "cd tests/unit && npx vitest run meeting-server/joinConfigAcceptance.test.ts meeting-server/meetingCreateAcceptance.test.ts meeting-server/hostReadyGate.test.ts meeting-server/lobbyKeyResolve.test.ts meeting-server/meetingRuntimeApi.test.ts meeting-server/jibriWebhook.test.ts cross-portal/jitsiMeetingConfig.test.ts",
    "test:zero-exception": "node scripts/run-zero-exception-suite.mjs",
    "test:cycle2-live": "node scripts/run-cycle2-live-diagnostic.mjs",
    "test:code-breaker": "node scripts/run-code-breaker-loop.mjs",
    "test:security-hardening": "node --test Izara-jitsi-server/tests/recordingAccess.test.mjs Izara-jitsi-server/tests/jwtPolicy.test.mjs Izara-jitsi-server/tests/webhookProdSecret.test.mjs && cd tests/unit && npx vitest run doctor-portal/jwtPolicyAlignment.test.ts patient-portal/malformedBody.test.ts",
    "test:triple-verification": "node scripts/run-triple-verification-loop.mjs",
    "test:forensic-gate": "node scripts/run-forensic-production-gate.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high --prefix Isara-patient-portal && npm audit --omit=dev --audit-level=high --prefix Isara-doctor-portal && npm audit --omit=dev --audit-level=high --prefix Izara-jitsi-server",
    "test:e2e:multi-browser": "npx playwright test --workers=1",
    "test:e2e:meeting-multibrowser": "npx playwright test --project=A-auth --project=D-appointments --project=E-meeting-clinical --workers=1",
    "test:e2e:auth": "npx playwright test --project=A-auth",
    "test:e2e:coverage": "pwsh scripts/run-full-coverage.ps1",
    "test:cloud": "pwsh scripts/run-cloud-tests.ps1",
    "test:cloud:headed": "pwsh scripts/run-cloud-tests.ps1 -Headed",
    "test:cloud:pipeline": "pwsh scripts/run-cloud-tests.ps1 -Headed --project=D-appointments --project=D-doctor-host --project=Q-meeting-lifecycle --project=E-meeting-clinical --project=F-phr-health-records --project=L-lab-ordering",
    "test:cloud:full": "pwsh scripts/run-cloud-full-coverage.ps1 -SkipHealthGate -Workers 1",
    "test:cloud:hardening": "pwsh scripts/run-two-round-cloud-hardening.ps1 -Round All -Headed",
    "test:cloud:debug": "pwsh scripts/run-cloud-full-coverage.ps1 -Workers 1 -SkipHealthGate",
    "test:cloud:hardening:round1": "pwsh scripts/run-two-round-cloud-hardening.ps1 -Round 1",
    "test:cloud:hardening:round2": "pwsh scripts/run-two-round-cloud-hardening.ps1 -Round 2",
    "ledger:cloud": "node scripts/aggregate-cloud-error-ledger.mjs",
    "cleanup:cloud-test": "pwsh scripts/cleanup-cloud-test-data.ps1 -Reseed",
    "cleanup:cloud-test-only": "pwsh scripts/cleanup-cloud-test-data.ps1",
    "guides:cleanup-old": "pwsh scripts/cleanup-old-user-guides.ps1",
    "guides:enrich": "python scripts/enrich-process-pages.py --force-steps",
    "guides:build": "python scripts/build-portal-user-guides.py",
    "guides:pdf": "pwsh scripts/export-user-guide-pdf.ps1",
    "guides:all": "npm run guides:cleanup-old && npm run guides:enrich && npm run guides:build && npm run guides:pdf",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "verify:gate0": "node scripts/verify-cloud-appointment-sync.mjs",
    "cloud:migrate": "node scripts/apply-cloud-db-from-env.cjs --cloud",
    "cloud:deploy": "pwsh scripts/deploy-cloud-from-env.ps1",
    "seed": "node scripts/database/db-tool.cjs --seed",
    "seed:all": "node scripts/database/db-tool.cjs --all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.17.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0"
  }
}
