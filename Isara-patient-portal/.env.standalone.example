# Standalone development — Patient Portal
# Copy to .env for local standalone stack (PG :5434)

DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=izara_phase1
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/izara_phase1
COMPOSE_PROJECT_NAME=isara-patient-standalone
PORT=3005
JWT_SECRET=standalone-dev-jwt-secret-change-in-prod
USE_POSTGRESQL=true
STANDALONE_MODE=1
