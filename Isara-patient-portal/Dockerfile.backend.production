# ============================================================================
# PATIENT PORTAL - BACKEND API DOCKERFILE
# For Google Cloud Run Deployment
# ============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including dev dependencies for build
RUN npm ci && npm cache clean --force

# Copy TypeScript source
COPY tsconfig.json tsconfig.server.json ./
COPY server ./server

# Build the TypeScript server
RUN npm run build:server

# Verify build
RUN ls -la /app/dist/server && echo "✅ Server build completed"

# Stage 2: Production runtime
FROM node:20-alpine

WORKDIR /app

# Install production dependencies and tools
RUN apk add --no-cache \
    curl \
    bash \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY package*.json ./

# Install only production dependencies
RUN npm ci --only=production && npm cache clean --force

# Copy built server from builder
COPY --from=builder /app/dist/server ./dist/server

# Create directory for GCP credentials (will be mounted or injected)
RUN mkdir -p /var/secrets/google

# Environment variables (will be set at runtime)
ENV NODE_ENV=production
ENV PORT=8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE 8080

# Run the server
CMD ["node", "dist/server/index.js"]
