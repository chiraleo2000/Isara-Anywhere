# Izara Patient Portal - Environment Configuration (template)
# Copy to .env — sync shared keys with doctor portal and .env.docker

# ============================================================================
# APPLICATION
# ============================================================================
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development

# ============================================================================
# API / URLS
# ============================================================================
VITE_API_URL=http://localhost:3005
VITE_AUTH_PORTAL_URL=http://localhost:3005/auth
VITE_PATIENT_URL=http://localhost:3005/home
VITE_WEBSOCKET_URL=ws://localhost:3005/ws
MEETING_SERVER_URL=http://localhost:3020
VITE_MEETING_SERVER_URL=http://localhost:3020

# ============================================================================
# DATABASE (server-side)
# ============================================================================
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5433/izara_phase1
DB_HOST=localhost
DB_PORT=5433
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=your-db-password
USE_POSTGRESQL=true

# ============================================================================
# GCP / OAUTH
# ============================================================================
GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_REGION=asia-southeast1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================================
# GOOGLE APIS (patient: maps + calendar proxy)
# ============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id
VITE_GOOGLE_CALENDAR_API_KEY=your-google-api-key
VITE_GOOGLE_MEET_API_KEY=your-google-api-key

# ============================================================================
# GEMINI AI — xxxxx = AI disabled until you add a real AIza… key
# ============================================================================
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# ============================================================================
# FEATURE FLAGS (consumed at runtime)
# ============================================================================
VITE_PDPA_ENABLED=true
VITE_AUDIT_LOGGING_ENABLED=true

# ============================================================================
# JITSI / MEETINGS
# ============================================================================
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
VITE_JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SERVER
# ============================================================================
PORT=3005
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-min-32-chars
