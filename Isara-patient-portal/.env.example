# Application Info
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=1.0.0

# GCP Configuration
VITE_GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_REGION=asia-southeast1

# OAuth (for Google Sign-In and GCS access)
VITE_GOOGLE_CLIENT_ID=xxx
VITE_OAUTH_REDIRECT_URI=http://localhost:3005/auth/callback
VITE_GOOGLE_CLIENT_SECRET=xxx

# App URLs
# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
VITE_API_URL=http://localhost:3004
VITE_AUTH_PORTAL_URL=http://localhost:3004/auth
VITE_PATIENT_URL=http://localhost:3005/home
VITE_WEBSOCKET_URL=ws://localhost:3005/ws


# ============================================================================
# GOOGLE APIS
# ============================================================================
VITE_GOOGLE_CALENDAR_API_KEY=xxx
VITE_GOOGLE_MEET_API_KEY=xxx
VITE_GOOGLE_MAPS_API_KEY=xxx
# Map ID for AdvancedMarkerElement (optional - suppresses deprecation warnings)
# Create at: Google Cloud Console > Google Maps Platform > Map Management > Create Map ID
# See: https://developers.google.com/maps/documentation/javascript/advanced-markers/start#create-a-map-id
VITE_GOOGLE_MAPS_MAP_ID=

# Google Cloud Speech-to-Text API (for post-meeting transcription)
VITE_GOOGLE_SPEECH_API_KEY=xxx
GOOGLE_SPEECH_API_KEY=xxx

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
VITE_GEMINI_API_KEY=xxx
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_TEMPERATURE=0.3
VITE_GEMINI_MAX_TOKENS=8192

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# PDPA Compliance
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_AUDIT_LOGGING_ENABLED=true

# EMR/EHR Features
VITE_EMR_PATIENT_ACCESS_CONTROL=true
VITE_EMR_AUTO_SAVE_INTERVAL=30040
VITE_EMR_VERSION_CONTROL=true

# Clinical Features
VITE_E_PRESCRIBING_ENABLED=true
VITE_DRUG_INTERACTION_CHECK=true
VITE_LAB_ORDERING_ENABLED=true
VITE_IMAGING_ORDERING_ENABLED=true

# AI Features
VITE_AI_CLINICAL_ASSIST=true
VITE_AI_VOICE_TRANSCRIPTION=true
VITE_AI_NOTE_SUMMARIZATION=true
VITE_AI_ICD_CODING_ASSIST=true
VITE_AI_DRUG_INFO=true

# Other Features
VITE_LIVING_WILL_ENABLED=true
VITE_PHR_WEARABLES_ENABLED=true
VITE_VIDEO_CONSULTATION_ENABLED=true
VITE_QUEUE_MANAGEMENT_ENABLED=true
VITE_REAL_TIME_UPDATES=true

# ============================================================================
# VIDEO MEETING - JITSI MEET (FREE)
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
VITE_JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
VITE_SESSION_TIMEOUT=1800000
VITE_MFA_ENABLED=false
VITE_ENCRYPTION_ENABLED=true

# ============================================================================
# MOBILE/PWA SETTINGS
# ============================================================================
VITE_PWA_ENABLED=true
VITE_OFFLINE_MODE_ENABLED=true
VITE_PUSH_NOTIFICATIONS_ENABLED=true
