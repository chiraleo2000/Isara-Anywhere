# ============================================================================
# DOCTOR PORTAL - PRODUCTION FRONTEND DOCKERFILE
# For Google Cloud Run Deployment
# ============================================================================

# Stage 1: Build the React application
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# Copy source code
COPY . .

# Build arguments for environment variables
ARG VITE_APP_NAME="Izara Doctor Portal"
ARG VITE_APP_VERSION="1.0.0"
ARG VITE_APP_ENV="production"
ARG VITE_API_URL
ARG VITE_AUTH_URL
ARG VITE_DOCTOR_URL
ARG VITE_WEBSOCKET_URL
ARG GCS_API_URL
ARG VITE_GCP_PROJECT_ID
ARG VITE_GCP_REGION
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GCS_BUCKET_AUTH
ARG VITE_GCS_BUCKET_DOCTOR
ARG VITE_GCS_BUCKET_PATIENT
ARG VITE_GCS_BUCKET_APPOINTMENTS
ARG VITE_GCS_BUCKET_METADATA
ARG VITE_GOOGLE_CALENDAR_API_KEY
ARG VITE_GOOGLE_MEET_API_KEY
ARG VITE_GEMINI_API_KEY
ARG VITE_GEMINI_MODEL
ARG VITE_PDPA_ENABLED
ARG VITE_CONSENT_REQUIRED

# Set environment variables for build
ENV VITE_APP_NAME=${VITE_APP_NAME}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_AUTH_URL=${VITE_AUTH_URL}
ENV VITE_DOCTOR_URL=${VITE_DOCTOR_URL}
ENV VITE_WEBSOCKET_URL=${VITE_WEBSOCKET_URL}
ENV GCS_API_URL=${GCS_API_URL}
ENV VITE_GCP_PROJECT_ID=${VITE_GCP_PROJECT_ID}
ENV VITE_GCP_REGION=${VITE_GCP_REGION}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_GCS_BUCKET_AUTH=${VITE_GCS_BUCKET_AUTH}
ENV VITE_GCS_BUCKET_DOCTOR=${VITE_GCS_BUCKET_DOCTOR}
ENV VITE_GCS_BUCKET_PATIENT=${VITE_GCS_BUCKET_PATIENT}
ENV VITE_GCS_BUCKET_APPOINTMENTS=${VITE_GCS_BUCKET_APPOINTMENTS}
ENV VITE_GCS_BUCKET_METADATA=${VITE_GCS_BUCKET_METADATA}
ENV VITE_GOOGLE_CALENDAR_API_KEY=${VITE_GOOGLE_CALENDAR_API_KEY}
ENV VITE_GOOGLE_MEET_API_KEY=${VITE_GOOGLE_MEET_API_KEY}
ENV VITE_GEMINI_API_KEY=${VITE_GEMINI_API_KEY}
ENV VITE_GEMINI_MODEL=${VITE_GEMINI_MODEL}
ENV VITE_PDPA_ENABLED=${VITE_PDPA_ENABLED}
ENV VITE_CONSENT_REQUIRED=${VITE_CONSENT_REQUIRED}

# Build the application
RUN npm run build

# Verify build output
RUN ls -la /app/dist && echo "✅ Frontend build completed"

# Stage 2: Production runtime with Nginx
FROM nginx:1.25-alpine

# Install required packages
RUN apk add --no-cache \
    bash \
    curl \
    gettext \
    && rm -rf /var/cache/apk/*

# Copy Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create runtime environment injection template
RUN cat > /usr/share/nginx/html/env-config.template.js << 'EOF'
window.ENV = {
  API_URL: "${VITE_API_URL}",
  AUTH_URL: "${VITE_AUTH_URL}",
  DOCTOR_URL: "${VITE_DOCTOR_URL}",
  WEBSOCKET_URL: "${VITE_WEBSOCKET_URL}",
  GCS_API_URL: "${GCS_API_URL}",
  GCP_PROJECT_ID: "${VITE_GCP_PROJECT_ID}",
  GCP_REGION: "${VITE_GCP_REGION}",
  GOOGLE_CLIENT_ID: "${VITE_GOOGLE_CLIENT_ID}",
  GCS_BUCKET_AUTH: "${VITE_GCS_BUCKET_AUTH}",
  GCS_BUCKET_DOCTOR: "${VITE_GCS_BUCKET_DOCTOR}",
  GCS_BUCKET_PATIENT: "${VITE_GCS_BUCKET_PATIENT}",
  GCS_BUCKET_APPOINTMENTS: "${VITE_GCS_BUCKET_APPOINTMENTS}",
  GCS_BUCKET_METADATA: "${VITE_GCS_BUCKET_METADATA}",
  GOOGLE_CALENDAR_API_KEY: "${VITE_GOOGLE_CALENDAR_API_KEY}",
  GOOGLE_MEET_API_KEY: "${VITE_GOOGLE_MEET_API_KEY}",
  GEMINI_API_KEY: "${VITE_GEMINI_API_KEY}",
  GEMINI_MODEL: "${VITE_GEMINI_MODEL}",
  PDPA_ENABLED: "${VITE_PDPA_ENABLED}",
  CONSENT_REQUIRED: "${VITE_CONSENT_REQUIRED}"
};
EOF

# Docker entrypoint script
RUN cat > /docker-entrypoint.sh << 'EOF'
#!/bin/bash
set -e

echo "🚀 Starting Izara Doctor Portal..."

# Inject environment variables into config file
envsubst < /usr/share/nginx/html/env-config.template.js > /usr/share/nginx/html/env-config.js

echo "✅ Environment configuration injected"

# Start nginx
exec "$@"
EOF

RUN chmod +x /docker-entrypoint.sh

# Set ownership
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Expose port (Cloud Run uses PORT env var, default to 8080)
ENV PORT=8080
EXPOSE 8080

# Use the entrypoint script
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
