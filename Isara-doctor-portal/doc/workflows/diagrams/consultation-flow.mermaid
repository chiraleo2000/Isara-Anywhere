sequenceDiagram
    %% Izara Doctor Portal - Complete Consultation Flow
    
    title Complete Consultation Flow
    
    participant P as Patient
    participant PP as Patient Portal
    participant DP as Doctor Portal
    participant D as Doctor
    participant API as GCS API
    participant AI as Gemini AI
    participant G as GCS
    participant N as Notifications
    
    rect rgb(240, 248, 255)
        Note over P,G: Phase 1: Booking
        P->>PP: Request appointment
        PP->>API: GET /api/doctors/availability
        API-->>PP: Available slots
        P->>PP: Select slot & confirm
        PP->>API: POST /api/appointments
        API->>G: Create appointment
        API->>N: Send confirmation
        N-->>P: Email/SMS confirmation
    end
    
    rect rgb(255, 248, 240)
        Note over P,G: Phase 2: Pre-Consultation (15 min before)
        API->>API: Trigger meeting setup
        API->>G: Create Google Meet link
        API->>N: Send meeting reminder
        N-->>P: Join link via email/SMS
        P->>DP: Join waiting room
        DP->>API: Record patient check-in
        API->>DP: WebSocket: patient_waiting
        DP-->>D: Patient ready notification
    end
    
    rect rgb(240, 255, 240)
        Note over P,G: Phase 3: Consultation
        D->>DP: Start consultation
        DP->>API: Update status: In Progress
        
        D->>DP: Open video call
        P->>DP: Join video call
        
        loop During Consultation
            P->>D: Describe symptoms
            D->>AI: Analyze symptoms
            AI-->>D: Suggestions & warnings
            D->>DP: Document findings
        end
        
        D->>DP: Record vital signs
        D->>DP: Add diagnoses
        D->>DP: Create prescription
        D->>AI: Check drug interactions
        AI-->>D: Safety check results
        D->>DP: Order lab tests
    end
    
    rect rgb(255, 240, 245)
        Note over P,G: Phase 4: Post-Consultation
        D->>DP: End consultation
        DP->>AI: Generate summary
        AI-->>DP: AI consultation summary
        D->>DP: Review & approve summary
        
        DP->>API: Finalize EMR
        API->>G: Save EMR record
        
        DP->>API: Send prescription
        API->>G: Save prescription
        API->>N: Send Rx to pharmacy
        
        DP->>API: Complete appointment
        API->>G: Update status: Completed
        API->>N: Send summary to patient
        N-->>P: Email consultation summary
    end
    
    rect rgb(245, 240, 255)
        Note over P,G: Phase 5: Follow-up
        API->>N: Schedule follow-up reminder
        N-->>P: Follow-up reminder
        P->>PP: Book follow-up appointment
    end
