%% Doctor Approval Process
%% Izara Doctor Portal - Admin Workflow

flowchart TD
    subgraph Registration["📝 Registration Phase"]
        R1[Doctor Visits Portal]
        R2[Fills Registration Form]
        R3[Submit with Pending Status]
        R4[Save to GCS]
        R5[Add to Pending Queue]
    end

    subgraph Notification["📧 Notification Phase"]
        N1[Generate Email]
        N2[Send to Admin]
        N3[Admin Receives Alert]
    end

    subgraph Review["🔍 Review Phase"]
        RV1[Admin Opens Portal]
        RV2[Navigate to Doctor Management]
        RV3[View Pending Tab]
        RV4[Select Doctor]
        RV5[Review Details]
    end

    subgraph Decision["⚖️ Decision Phase"]
        D1{Review Complete}
        D2[Click Approve]
        D3[Click Reject]
        D4[Confirm Modal]
        D5[Enter Reason]
    end

    subgraph Processing["⚙️ Processing Phase"]
        P1[Update Status in GCS]
        P2[Update Users Index]
        P3[Update Doctors List]
        P4[Log Audit Trail]
    end

    subgraph Outcome["✅ Outcome Phase"]
        O1[Send Approval Email]
        O2[Send Rejection Email]
        O3[Doctor Can Login]
        O4[Doctor Cannot Login]
    end

    %% Flow Connections
    R1 --> R2 --> R3 --> R4 --> R5
    R5 --> N1 --> N2 --> N3
    N3 --> RV1 --> RV2 --> RV3 --> RV4 --> RV5
    RV5 --> D1
    
    D1 -->|Approve| D2 --> D4
    D1 -->|Reject| D3 --> D5 --> D4
    
    D4 --> P1 --> P2 --> P3 --> P4
    
    P4 -->|If Approved| O1 --> O3
    P4 -->|If Rejected| O2 --> O4

    style Registration fill:#e3f2fd
    style Notification fill:#fff3e0
    style Review fill:#f3e5f5
    style Decision fill:#fce4ec
    style Processing fill:#e8f5e9
    style Outcome fill:#fffde7
