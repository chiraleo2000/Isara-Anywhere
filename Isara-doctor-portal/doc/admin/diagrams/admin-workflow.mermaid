%% Admin Workflow - Main Operations
%% Izara Doctor Portal

flowchart TB
    subgraph Login["🔐 Admin Authentication"]
        A1[Login Page] --> A2{Validate Credentials}
        A2 -->|Valid| A3{Is Admin?}
        A2 -->|Invalid| A4[Error]
        A3 -->|Yes| A5[Admin Dashboard]
        A3 -->|No| A6[Doctor Dashboard]
    end

    subgraph AdminDashboard["🏠 Admin Dashboard"]
        AD1[View Statistics]
        AD2[Pending Approvals Count]
        AD3[Today's Appointments]
        AD4[Quick Actions]
    end

    subgraph DoctorMgmt["👨‍⚕️ Doctor Management"]
        DM1[View All Doctors]
        DM2[Filter by Status]
        DM3[Search Doctors]
        DM4[View Pending]
        DM5[Review Application]
        DM6{Decision}
        DM7[Approve]
        DM8[Reject]
        DM9[Send Notification]
    end

    subgraph ApptMgmt["📅 Appointment Management"]
        AM1[View All Requests]
        AM2[Filter by Status]
        AM3[View Pending]
        AM4[Review Request]
        AM5[Check Availability]
        AM6[Select Doctor]
        AM7[Set DateTime]
        AM8[Assign]
        AM9[Notify Parties]
    end

    subgraph Monitoring["📊 System Monitoring"]
        SM1[User Activity]
        SM2[Appointment Stats]
        SM3[Doctor Performance]
        SM4[System Health]
    end

    %% Connections
    A5 --> AdminDashboard
    AdminDashboard --> DoctorMgmt
    AdminDashboard --> ApptMgmt
    AdminDashboard --> Monitoring

    DM1 --> DM2 --> DM3 --> DM4 --> DM5 --> DM6
    DM6 -->|Approve| DM7 --> DM9
    DM6 -->|Reject| DM8 --> DM9

    AM1 --> AM2 --> AM3 --> AM4 --> AM5 --> AM6 --> AM7 --> AM8 --> AM9

    style Login fill:#e8f5e9
    style DoctorMgmt fill:#e3f2fd
    style ApptMgmt fill:#fff3e0
    style Monitoring fill:#f3e5f5
