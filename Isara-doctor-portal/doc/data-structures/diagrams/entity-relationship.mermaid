erDiagram
    %% Izara Doctor Portal - Entity Relationship Diagram
    
    %% ===============================
    %% USER & AUTHENTICATION
    %% ===============================
    
    USERS {
        string id PK "DOC-XXXX-XXX"
        string email UK
        string password_hash
        enum role "doctor|admin|patient"
        string doctor_id FK
        string medical_license_number UK
        boolean is_admin
        boolean is_active
        boolean email_verified
        enum approval_status "pending|approved|rejected"
        datetime created_at
        datetime last_login
        int login_attempts
        datetime locked_until
        string name
        string phone
        date date_of_birth
        string avatar_url
        string specialty
    }
    
    USER_PREFERENCES {
        string id PK
        string user_id FK
        enum theme "light|dark|system"
        enum language "en|th"
        boolean notification_email
        boolean notification_push
        boolean notification_sms
    }
    
    ADMIN_PRIVILEGES {
        string id PK
        string user_id FK
        boolean can_manage_doctors
        boolean can_manage_patients
        boolean can_manage_appointments
        boolean can_view_analytics
        boolean can_manage_settings
        boolean can_assign_roles
        enum level "super_admin|admin|moderator"
    }
    
    SESSIONS {
        string token PK
        string user_id FK
        datetime created_at
        datetime expires_at
        string user_agent
        string ip_address
        boolean is_valid
    }
    
    %% ===============================
    %% DOCTORS
    %% ===============================
    
    DOCTORS {
        string id PK
        string name
        string specialty
        string email
        string avatar_url
        decimal rating
        string experience
        boolean is_approved
        string medical_license_number UK
    }
    
    DOCTOR_QUALIFICATIONS {
        string id PK
        string doctor_id FK
        string qualification
        string institution
        int year
    }
    
    %% ===============================
    %% PATIENTS
    %% ===============================
    
    PATIENTS {
        string id PK "PAT-YYYY-NNNN"
        string name
        date date_of_birth
        int age
        enum gender "male|female|other"
        string photo
        string id_number UK
        string phone
        string email
        text address
        string blood_type
        enum risk_level "low|medium|high"
        boolean is_active
        datetime last_visit
        datetime next_appointment
    }
    
    EMERGENCY_CONTACTS {
        string id PK
        string patient_id FK
        string name
        string relationship
        string phone
        string email
    }
    
    PATIENT_ALLERGIES {
        string id PK
        string patient_id FK
        string allergen
        string reaction
        enum severity "mild|moderate|severe"
    }
    
    PATIENT_CONSENTS {
        string id PK
        string patient_id FK
        boolean has_consent
        datetime expires_at
    }
    
    %% ===============================
    %% EMR (ELECTRONIC MEDICAL RECORDS)
    %% ===============================
    
    EMR_RECORDS {
        string id PK "EMR-YYYY-NNNN-SEQ"
        string patient_id FK
        string doctor_id FK
        string doctor_name
        datetime encounter_date
        enum encounter_type "consultation|follow-up|emergency|procedure"
        text chief_complaint
        text history_of_present_illness
        text assessment
        text treatment_plan
        text follow_up_instructions
        date follow_up_date
        enum status "draft|finalized|amended"
        string digital_signature
        int version
        datetime created_at
        datetime last_modified
    }
    
    VITAL_SIGNS {
        string id PK
        string emr_id FK
        int bp_systolic
        int bp_diastolic
        int heart_rate
        decimal temperature
        int respiratory_rate
        decimal oxygen_saturation
        decimal weight
        decimal height
        decimal bmi
        datetime measured_at
    }
    
    DIAGNOSES {
        string id PK
        string emr_id FK
        string code "ICD-10"
        string description
        enum type "primary|secondary"
        date onset
        enum status "active|resolved|chronic"
    }
    
    %% ===============================
    %% PRESCRIPTIONS
    %% ===============================
    
    PRESCRIPTIONS {
        string id PK "RX-YYYY-NNNN-SEQ"
        string patient_id FK
        string doctor_id FK
        string emr_id FK
        datetime encounter_date
        string pharmacy_id
        enum status "pending|sent|dispensed|cancelled"
        string digital_signature
        datetime created_at
        datetime valid_until
    }
    
    PRESCRIPTION_ITEMS {
        string id PK
        string prescription_id FK
        string drug_name
        string generic_name
        string brand_name
        string dosage
        string strength
        enum route "oral|injection|topical|inhaled|rectal|other"
        string frequency
        string duration
        int quantity
        int refills
        text instructions
    }
    
    %% ===============================
    %% LAB ORDERS
    %% ===============================
    
    LAB_ORDERS {
        string id PK "LAB-YYYY-NNNN-SEQ"
        string patient_id FK
        string doctor_id FK
        string emr_id FK
        datetime order_date
        text clinical_indication
        enum urgency "routine|urgent|stat"
        enum status "ordered|collected|in_progress|completed|cancelled"
        datetime completed_at
    }
    
    LAB_TESTS {
        string id PK
        string lab_order_id FK
        string test_code
        string test_name
        string category
        string specimen_type
        text instructions
    }
    
    LAB_RESULTS {
        string id PK
        string lab_test_id FK
        string value
        string unit
        string reference_range
        enum status "normal|abnormal|critical"
        text notes
        datetime resulted_at
    }
    
    %% ===============================
    %% APPOINTMENTS
    %% ===============================
    
    APPOINTMENTS {
        string id PK "APT-YYYY-MMDD-SEQ"
        string patient_id FK
        string doctor_id FK
        datetime date
        enum type "Telehealth|In-person|Emergency|Follow-up|Consultation"
        enum status "Pending|Confirmed|In Progress|Completed|Cancelled|No Show|Rescheduled"
        text notes
        string meet_link
        string calendar_event_id
        text diagnosis
        text summary
        enum payment_status "unpaid|partial|paid|refunded"
        datetime created_at
        datetime updated_at
        datetime confirmed_at
    }
    
    APPOINTMENT_SYMPTOMS {
        string id PK
        string appointment_id FK
        string symptom
        enum severity "mild|moderate|severe"
        string duration
    }
    
    %% ===============================
    %% QUEUE MANAGEMENT
    %% ===============================
    
    QUEUE_PATIENTS {
        string id PK "Q-YYYY-SEQ"
        string doctor_id FK
        string patient_id FK
        string patient_name
        string appointment_id FK
        datetime appointment_time
        datetime check_in_time
        text reason
        enum priority "routine|urgent|emergency|high"
        enum status "waiting|in-consultation|in-progress|completed|no-show|skipped"
        int estimated_wait_time
        int queue_position
        int queue_number
        datetime added_at
        datetime updated_at
    }
    
    %% ===============================
    %% MEETINGS/TELEMEDICINE
    %% ===============================
    
    MEETING_SESSIONS {
        string id PK "MEET-YYYY-MMDD-SEQ"
        string appointment_id FK
        datetime start_time
        datetime end_time
        int duration
        string recording_url
        text notes
        enum status "scheduled|waiting|active|completed|cancelled"
        string meet_link
        datetime patient_joined_at
        datetime doctor_joined_at
        boolean consent_recorded
    }
    
    MEETING_PARTICIPANTS {
        string id PK
        string meeting_id FK
        string user_id FK
        enum role "doctor|patient|observer"
        datetime joined_at
        datetime left_at
        boolean video_enabled
        boolean audio_enabled
    }
    
    MEETING_AI_SUMMARIES {
        string id PK
        string meeting_id FK
        text chief_complaint
        text diagnosis
        boolean follow_up_recommended
        date follow_up_date
        decimal confidence
        datetime generated_at
    }
    
    %% ===============================
    %% PAYMENTS
    %% ===============================
    
    PAYMENT_TRANSACTIONS {
        string id PK
        string appointment_id FK
        datetime transaction_date
        decimal total_amount
        decimal paid_amount
        decimal remaining_balance
        string currency "THB"
        enum payment_method "cash|credit_card|debit_card|bank_transfer|promptpay|insurance"
        enum status "pending|partial|completed|refunded|cancelled|failed"
        string receipt_url
        string transaction_reference
    }
    
    %% ===============================
    %% CONSENT RECORDS (PDPA)
    %% ===============================
    
    CONSENT_RECORDS {
        string id PK "CON-YYYY-SEQ"
        string patient_id FK
        string doctor_id FK
        enum consent_type "phr-access|ehr-access|data-sharing|research|recording"
        boolean granted
        datetime granted_at
        datetime expires_at
        string signature_url
        string witness_name
    }
    
    %% ===============================
    %% REFERENCE DATA
    %% ===============================
    
    MEDICATIONS_REF {
        string id PK
        string name
        string generic_name
        string category
        text contraindications
        text side_effects
    }
    
    LAB_TESTS_REF {
        string id PK
        string code UK
        string name
        string category
        string specimen_type
    }
    
    ICD10_CODES {
        string code PK
        string description
        string category
        string chapter
    }
    
    %% ===============================
    %% AUDIT LOGGING
    %% ===============================
    
    AUDIT_LOGS {
        string id PK
        string user_id FK
        string action
        string resource_type
        string resource_id
        text old_value
        text new_value
        string ip_address
        datetime timestamp
    }
    
    %% ===============================
    %% RELATIONSHIPS
    %% ===============================
    
    USERS ||--o| USER_PREFERENCES : has
    USERS ||--o| ADMIN_PRIVILEGES : has
    USERS ||--o{ SESSIONS : creates
    USERS ||--o| DOCTORS : is
    
    DOCTORS ||--o{ DOCTOR_QUALIFICATIONS : has
    DOCTORS ||--o{ QUEUE_PATIENTS : manages
    DOCTORS ||--o{ APPOINTMENTS : handles
    DOCTORS ||--o{ EMR_RECORDS : creates
    DOCTORS ||--o{ PRESCRIPTIONS : writes
    DOCTORS ||--o{ LAB_ORDERS : orders
    DOCTORS ||--o{ CONSENT_RECORDS : obtains
    
    PATIENTS ||--o{ EMERGENCY_CONTACTS : has
    PATIENTS ||--o{ PATIENT_ALLERGIES : has
    PATIENTS ||--o| PATIENT_CONSENTS : gives
    PATIENTS ||--o{ APPOINTMENTS : books
    PATIENTS ||--o{ EMR_RECORDS : has
    PATIENTS ||--o{ PRESCRIPTIONS : receives
    PATIENTS ||--o{ LAB_ORDERS : has
    PATIENTS ||--o{ CONSENT_RECORDS : signs
    PATIENTS ||--o{ QUEUE_PATIENTS : enters
    
    EMR_RECORDS ||--|| VITAL_SIGNS : contains
    EMR_RECORDS ||--o{ DIAGNOSES : includes
    EMR_RECORDS ||--o{ PRESCRIPTIONS : generates
    EMR_RECORDS ||--o{ LAB_ORDERS : triggers
    
    PRESCRIPTIONS ||--o{ PRESCRIPTION_ITEMS : contains
    
    LAB_ORDERS ||--o{ LAB_TESTS : includes
    LAB_TESTS ||--o{ LAB_RESULTS : produces
    
    APPOINTMENTS ||--o{ APPOINTMENT_SYMPTOMS : has
    APPOINTMENTS ||--o| MEETING_SESSIONS : has
    APPOINTMENTS ||--o| PAYMENT_TRANSACTIONS : has
    APPOINTMENTS ||--o| QUEUE_PATIENTS : creates
    
    MEETING_SESSIONS ||--o{ MEETING_PARTICIPANTS : has
    MEETING_SESSIONS ||--o| MEETING_AI_SUMMARIES : generates
    
    USERS ||--o{ MEETING_PARTICIPANTS : joins
    USERS ||--o{ AUDIT_LOGS : generates
    
    PRESCRIPTION_ITEMS }o--|| MEDICATIONS_REF : references
    LAB_TESTS }o--|| LAB_TESTS_REF : references
    DIAGNOSES }o--|| ICD10_CODES : uses
