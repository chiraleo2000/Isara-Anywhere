%% Izara Doctor Portal - User Journey Map v2.0
%% Comprehensive doctor workflow from registration to daily operations

flowchart TB
    %% Registration Phase
    subgraph Registration["🔐 REGISTRATION & ONBOARDING"]
        direction LR
        R1["🌐 Visit Portal"] --> R2["📝 Register Account"]
        R2 --> R3["📄 Submit Credentials<br/>(License, Photo)"]
        R3 --> R4["⏳ Await Admin<br/>Approval"]
        R4 --> R5["📧 Receive Approval<br/>Email"]
        R5 --> R6["🔑 First Login"]
        R6 --> R7["👤 Complete Profile"]
    end
    
    %% Daily Start
    subgraph DailyStart["🌅 START OF DAY"]
        direction LR
        D1["🔐 Login"] --> D2["📊 View Dashboard"]
        D2 --> D3["🔔 Check Notifications"]
        D3 --> D4["📅 Review Today's<br/>Schedule"]
        D4 --> D5["📋 Open Queue<br/>Manager"]
    end
    
    %% Consultation Flow
    subgraph Consultation["💊 PATIENT CONSULTATION"]
        direction TB
        
        subgraph PreConsult["⏰ Pre-Consultation"]
            C1["👤 Patient Arrives/<br/>Connects"]
            C1 --> C2["✅ Check-in to Queue"]
            C2 --> C3["📂 Review Patient<br/>History"]
            C3 --> C4["📞 Call Patient"]
        end
        
        subgraph ActiveConsult["🎥 Active Consultation"]
            C5["▶️ Start Consultation"]
            C5 --> C6["❤️ Record Vitals"]
            C6 --> C7["📝 Document Complaints"]
            C7 --> C8["🩺 Physical Exam/<br/>Assessment"]
            C8 --> C9["🤖 AI Analysis &<br/>Suggestions"]
            C9 --> C10["🏥 Diagnosis<br/>(ICD-10)"]
            C10 --> C11["📋 Treatment Plan"]
        end
        
        subgraph PostConsult["✅ Post-Consultation"]
            C12["💊 Write Prescription"]
            C12 --> C13["🧪 Order Labs"]
            C13 --> C14["📅 Set Follow-up"]
            C14 --> C15["✍️ Finalize EMR"]
            C15 --> C16["✅ Complete Visit"]
        end
        
        PreConsult --> ActiveConsult
        ActiveConsult --> PostConsult
    end
    
    subgraph Telemedicine["🎥 Telemedicine Flow"]
        direction LR
        T1[Patient Waiting] --> T2[Join Video Call]
        T2 --> T3[Conduct Consultation]
        T3 --> T4[AI Copilot Active]
        T4 --> T5[End Call]
        T5 --> T6[Review AI Summary]
    end
    
    subgraph Admin["⚙️ Administrative Tasks"]
        direction LR
        A1[Review Reports] --> A2[Manage Settings]
        A2 --> A3[Approve New Doctors]
        A3 --> A4[View Analytics]
        A4 --> A5[Audit Logs]
    end
    
    subgraph EndDay["🌙 End of Day"]
        direction LR
        E1[Complete Pending EMRs] --> E2[Review Tomorrow's Schedule]
        E2 --> E3[Update Availability]
        E3 --> E4[Logout]
    end
    
    %% Flow connections
    Registration --> DailyStart
    DailyStart --> Consultation
    DailyStart --> Telemedicine
    DailyStart --> Admin
    Consultation --> EndDay
    Telemedicine --> EndDay
    Admin --> EndDay
    
    %% Styling
    classDef start fill:#c8e6c9,stroke:#2e7d32
    classDef process fill:#bbdefb,stroke:#1565c0
    classDef decision fill:#fff9c4,stroke:#f9a825
    classDef end_node fill:#ffcdd2,stroke:#c62828
    classDef admin fill:#e1bee7,stroke:#7b1fa2
    
    class R1,D1 start
    class R2,R3,R4,R5,R6,R7,D2,D3,D4,D5 process
    class C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15,C16 process
    class T1,T2,T3,T4,T5,T6 process
    class A1,A2,A3,A4,A5 admin
    class E1,E2,E3,E4 end_node
