# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist
dist-ssr
*.local

# Environment files (will be injected at runtime)
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage
.nyc_output

# Git
.git
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
!README.md
docs/
.github/
READ/

# Docker files (no need to copy into container)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts (seed/test scripts not needed in production)
scripts/generate*
scripts/seed*
scripts/test*

# Keep deployment scripts
!scripts/deploy/

# Misc
*.log
.cache
temp/
tmp/

# Server logs
server/logs/*

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
