# Izara Doctor Portal - Unified Docker Image
# syntax=docker/dockerfile:1
# Runs frontend (Nginx) + all backend services (Node.js) in a single container
# Optimized for Google Cloud Run deployment

# =============================================================================
# STAGE 1: Build React Frontend
# =============================================================================
FROM node:22-alpine AS frontend-builder
WORKDIR /app
ENV NODE_ENV=development
ENV NPM_CONFIG_FETCH_TIMEOUT=600000
ENV NPM_CONFIG_FETCH_RETRIES=5

COPY package*.json ./
RUN npm ci && npm cache clean --force
COPY . .
RUN rm -rf node_modules && npm ci && npm cache clean --force

# ============================================================================
# Build-time environment variables for Vite (from .env)
# ============================================================================
# Application Info
ARG VITE_APP_NAME="Izara Doctor Portal"
ARG VITE_APP_VERSION="1.6.0"
ARG VITE_APP_ENV="production"

# API URLs (internal for Cloud Run)
ARG VITE_API_URL
ARG VITE_AUTH_URL
ARG VITE_DOCTOR_URL
ARG VITE_WEBSOCKET_URL

# GCP Configuration
ARG VITE_GCP_PROJECT_ID=izara-telemedicine
ARG VITE_GCP_REGION=asia-southeast1

# OAuth
ARG GOOGLE_CLIENT_ID=724889190329-svf2733fjqklfic9tet9d2qkmhkgmu0l.apps.googleusercontent.com

# (Google Cloud Storage buckets removed — PostgreSQL + local FS only)

# Build-time API credentials: pass via BuildKit secret file (not ARG/ENV — Sonar S6472 / layer safety).
#   docker build --secret id=vite_build_env,src=.env.vite.build ...
# Local/CI without secrets: Vite build uses empty optional keys from env-config template.

# Jitsi Meet Video Conferencing (FREE)
ARG JITSI_DOMAIN=meet.jit.si

# Gemini AI — model flags only at build; API credential via vite_build_env secret mount
ARG VITE_GEMINI_MODEL=gemini-3.1-flash-lite
ARG VITE_GEMINI_TEMPERATURE=0.3
ARG VITE_GEMINI_MAX_TOKENS=8192

# Feature Flags - PDPA
ARG VITE_PDPA_ENABLED=true
ARG VITE_CONSENT_REQUIRED=true
ARG VITE_AUDIT_LOGGING_ENABLED=true

# Feature Flags - EMR/EHR
ARG VITE_EMR_PATIENT_ACCESS_CONTROL=true
ARG VITE_EMR_AUTO_SAVE_INTERVAL=30000
ARG VITE_EMR_VERSION_CONTROL=true

# Feature Flags - Clinical
ARG VITE_E_PRESCRIBING_ENABLED=true
ARG VITE_DRUG_INTERACTION_CHECK=true
ARG VITE_LAB_ORDERING_ENABLED=true
ARG VITE_IMAGING_ORDERING_ENABLED=true

# Feature Flags - AI
ARG VITE_AI_CLINICAL_ASSIST=true
ARG VITE_AI_VOICE_TRANSCRIPTION=true
ARG VITE_AI_NOTE_SUMMARIZATION=true
ARG VITE_AI_ICD_CODING_ASSIST=true
ARG VITE_AI_DRUG_INFO=true

# Jitsi Meet Video Conferencing (FREE)
ARG JITSI_DOMAIN=meet.jit.si
ARG VITE_JITSI_DOMAIN=meet.jit.si
ARG JITSI_APP_ID=izara-telemedicine

# ============================================================================
# Set environment variables for Vite build
# ============================================================================
ENV VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_APP_VERSION=${VITE_APP_VERSION} \
    VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_AUTH_URL=${VITE_AUTH_URL} \
    VITE_DOCTOR_URL=${VITE_DOCTOR_URL} \
    VITE_WEBSOCKET_URL=${VITE_WEBSOCKET_URL} \
    VITE_GCP_PROJECT_ID=${VITE_GCP_PROJECT_ID} \
    VITE_GCP_REGION=${VITE_GCP_REGION} \
    GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID} \
    JITSI_DOMAIN=${JITSI_DOMAIN} \
    VITE_GEMINI_MODEL=${VITE_GEMINI_MODEL} \
    VITE_GEMINI_TEMPERATURE=${VITE_GEMINI_TEMPERATURE} \
    VITE_GEMINI_MAX_TOKENS=${VITE_GEMINI_MAX_TOKENS} \
    VITE_PDPA_ENABLED=${VITE_PDPA_ENABLED} \
    VITE_CONSENT_REQUIRED=${VITE_CONSENT_REQUIRED} \
    VITE_AUDIT_LOGGING_ENABLED=${VITE_AUDIT_LOGGING_ENABLED} \
    VITE_EMR_PATIENT_ACCESS_CONTROL=${VITE_EMR_PATIENT_ACCESS_CONTROL} \
    VITE_EMR_AUTO_SAVE_INTERVAL=${VITE_EMR_AUTO_SAVE_INTERVAL} \
    VITE_EMR_VERSION_CONTROL=${VITE_EMR_VERSION_CONTROL} \
    VITE_E_PRESCRIBING_ENABLED=${VITE_E_PRESCRIBING_ENABLED} \
    VITE_DRUG_INTERACTION_CHECK=${VITE_DRUG_INTERACTION_CHECK} \
    VITE_LAB_ORDERING_ENABLED=${VITE_LAB_ORDERING_ENABLED} \
    VITE_IMAGING_ORDERING_ENABLED=${VITE_IMAGING_ORDERING_ENABLED} \
    VITE_AI_CLINICAL_ASSIST=${VITE_AI_CLINICAL_ASSIST} \
    VITE_AI_VOICE_TRANSCRIPTION=${VITE_AI_VOICE_TRANSCRIPTION} \
    VITE_AI_NOTE_SUMMARIZATION=${VITE_AI_NOTE_SUMMARIZATION} \
    VITE_AI_ICD_CODING_ASSIST=${VITE_AI_ICD_CODING_ASSIST} \
    VITE_AI_DRUG_INFO=${VITE_AI_DRUG_INFO} \
    JITSI_DOMAIN=${JITSI_DOMAIN} \
    VITE_JITSI_DOMAIN=${VITE_JITSI_DOMAIN} \
    JITSI_APP_ID=${JITSI_APP_ID}

RUN chmod +x docker/vite-build.sh
# Cloud Build uses classic docker (no BuildKit); VITE_* already set via ENV above.
# Local BuildKit can still pass --secret id=vite_build_env when DOCKER_BUILDKIT=1.
RUN docker/vite-build.sh

# =============================================================================
# STAGE 2: Production Runtime (with embedded PostgreSQL)
# supervisord/nginx/postgres require root; app workers drop privileges in docker-entrypoint.sh
# NOSONAR docker:S6471
FROM node:22-alpine AS production
WORKDIR /app

# Cache bust - force rebuild v2.0.1
ARG CACHE_BUST=8

RUN apk add --no-cache \
    nginx \
    bash \
    curl \
    gettext \
    supervisor \
    postgresql17 \
    postgresql17-contrib \
  && rm -rf /var/cache/apk/* \
  && mkdir -p /run/postgresql /var/lib/postgresql/data \
  && chown -R postgres:postgres /run/postgresql /var/lib/postgresql

COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

COPY backend/ ./backend/
COPY shared/corsPolicy.cjs ./shared/corsPolicy.cjs
COPY shared/corsPolicy.cjs /shared/corsPolicy.cjs
RUN test -f ./shared/corsPolicy.cjs && test -f ./backend/loadCorsPolicy.cjs \
    || (echo "FATAL: corsPolicy loader missing" && exit 1) \
 && mkdir -p ./public /app/database
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Database SQL is mounted from host via docker-compose volumes, not baked into image

# Nginx configuration for reverse proxy (listen on 8080 for Cloud Run)
# hadolint ignore=DL3059
RUN printf '%s\n' \
'server {' \
'    listen 8080;' \
'    server_name localhost;' \
'    client_max_body_size 60m;' \
'    root /usr/share/nginx/html;' \
'    index index.html;' \
'    gzip on;' \
'    gzip_vary on;' \
'    gzip_min_length 1024;' \
'    gzip_types text/plain text/css text/xml text/javascript application/x-javascript' \
'        application/xml+rss application/javascript application/json;' \
'    add_header X-Frame-Options "SAMEORIGIN" always;' \
'    add_header X-Content-Type-Options "nosniff" always;' \
'    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;' \
'    add_header Referrer-Policy "strict-origin-when-cross-origin" always;' \
'    set $izara_cam "camera=(self \"https://meet.jit.si\" \"https://meet.localhost:8443\" \"https://meet.demotoday.net\")";' \
'    set $izara_mic "microphone=(self \"https://meet.jit.si\" \"https://meet.localhost:8443\" \"https://meet.demotoday.net\")";' \
'    set $izara_pp "$izara_cam, $izara_mic";' \
'    set $izara_pp "${izara_pp}, geolocation=(self), payment=(), usb=()";' \
'    add_header Permissions-Policy $izara_pp always;' \
'    add_header Content-Security-Policy "default-src '"'"'self'"'"' https:; script-src '"'"'self'"'"' '"'"'unsafe-inline'"'"' '"'"'unsafe-eval'"'"' https://meet.jit.si https://meet.localhost:8443 https://meet.demotoday.net https://8x8.vc https://accounts.google.com https://apis.google.com https://maps.googleapis.com; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"' https://fonts.googleapis.com https://accounts.google.com; font-src '"'"'self'"'"' https://fonts.gstatic.com; img-src '"'"'self'"'"' data: blob: https:; connect-src '"'"'self'"'"' http://localhost:* ws://localhost:* wss://localhost:* http://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:* http://host.docker.internal:* ws://host.docker.internal:* wss://host.docker.internal:* https://*.googleapis.com https://*.run.app wss://*.run.app wss://meet.jit.si https://meet.jit.si wss://meet.localhost:8443 https://meet.localhost:8443 wss://meet.demotoday.net https://meet.demotoday.net; frame-src '"'"'self'"'"' https://meet.jit.si https://meet.localhost:8443 https://meet.demotoday.net https://8x8.vc https://accounts.google.com; frame-ancestors '"'"'self'"'"'; object-src '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; media-src '"'"'self'"'"' blob: https: mediastream:; worker-src '"'"'self'"'"' blob:;" always;' \
'    location /health {' \
'        access_log off;' \
'        return 200 '"'"'{"status":"healthy","service":"izara-unified"}'"'"';' \
'        add_header Content-Type application/json;' \
'    }' \
'    location /env-config.js {' \
'        expires -1;' \
'        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";' \
'    }' \
'    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {' \
'        expires 1y;' \
'        add_header Cache-Control "public, immutable";' \
'    }' \
'    location /api/auth/ {' \
'        proxy_pass http://127.0.0.1:3011/auth/;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Upgrade $http_upgrade;' \
'        proxy_set_header Connection '"'"'upgrade'"'"';' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_cache_bypass $http_upgrade;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /api/consultants {' \
'        proxy_pass http://127.0.0.1:3009/api/consultants;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /api/content/ {' \
'        proxy_pass http://127.0.0.1:3009/api/content/;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /api/doctors {' \
'        proxy_pass http://127.0.0.1:3009/api/doctors;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /api/ {' \
'        proxy_pass http://127.0.0.1:3009/api/;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Upgrade $http_upgrade;' \
'        proxy_set_header Connection '"'"'upgrade'"'"';' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_cache_bypass $http_upgrade;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /auth/ {' \
'        proxy_pass http://127.0.0.1:3011/auth/;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Upgrade $http_upgrade;' \
'        proxy_set_header Connection '"'"'upgrade'"'"';' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_cache_bypass $http_upgrade;' \
'        proxy_connect_timeout 10s;' \
'        proxy_read_timeout 30s;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /admin/ {' \
'        proxy_pass http://127.0.0.1:3011/admin/;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Host $host;' \
'        proxy_set_header X-Real-IP $remote_addr;' \
'        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
'        proxy_set_header X-Forwarded-Proto $scheme;' \
'        proxy_intercept_errors off;' \
'    }' \
'    location /ws {' \
'        proxy_pass http://127.0.0.1:3011/ws;' \
'        proxy_http_version 1.1;' \
'        proxy_set_header Upgrade $http_upgrade;' \
'        proxy_set_header Connection "upgrade";' \
'        proxy_set_header Host $host;' \
'        proxy_read_timeout 86400;' \
'    }' \
'    location / {' \
'        try_files $uri $uri/ /index.html;' \
'    }' \
'    error_page 404 /index.html;' \
'}' > /etc/nginx/http.d/default.conf && \
\
printf '%s\n' \
'window.ENV = {' \
'  API_URL: "${VITE_API_URL}",' \
'  AUTH_URL: "${VITE_AUTH_URL}",' \
'  DOCTOR_URL: "${VITE_DOCTOR_URL}",' \
'  WEBSOCKET_URL: "${VITE_WEBSOCKET_URL}",' \
'  GCP_PROJECT_ID: "${GCP_PROJECT_ID}",' \
'  GCP_REGION: "${VITE_GCP_REGION}",' \
'  GOOGLE_CLIENT_ID: "${GOOGLE_CLIENT_ID}",' \
'  GEMINI_API_KEY: "${GEMINI_API_KEY}",' \
'  GEMINI_MODEL: "${GEMINI_MODEL}",' \
'  MEETING_SERVER_URL: "${VITE_MEETING_SERVER_URL}",' \
'  JITSI_DOMAIN: "${JITSI_DOMAIN}",' \
'  PDPA_ENABLED: "${VITE_PDPA_ENABLED}",' \
'  CONSENT_REQUIRED: "${VITE_CONSENT_REQUIRED}",' \
'  DEMO_AUTO_LOGIN: "${DEMO_AUTO_LOGIN}",' \
'  DEMO_AUTO_MEETING: "${DEMO_AUTO_MEETING}",' \
'  DEMO_DOCTOR_EMAIL: "${DEMO_DOCTOR_EMAIL}",' \
'  DEMO_DOCTOR_PASSWORD: "${DEMO_DOCTOR_PASSWORD}",' \
'  VITE_AUTO_ADMIT_LOBBY: "${VITE_AUTO_ADMIT_LOBBY}"' \
'};' > /usr/share/nginx/html/env-config.template.js && \
printf '%s\n' \
'[supervisord]' \
'nodaemon=true' \
'logfile=/var/log/supervisord.log' \
'pidfile=/var/run/supervisord.pid' \
'loglevel=info' \
'' \
'[program:nginx]' \
'command=/usr/sbin/nginx -g "daemon off;"' \
'priority=10' \
'autostart=true' \
'autorestart=true' \
'startsecs=1' \
'stdout_logfile=/dev/stdout' \
'stdout_logfile_maxbytes=0' \
'stderr_logfile=/dev/stderr' \
'stderr_logfile_maxbytes=0' \
'' \
'[program:auth-server]' \
'command=node /app/backend/authServer.cjs' \
'directory=/app' \
'priority=30' \
'autostart=true' \
'autorestart=true' \
'startsecs=5' \
'startretries=3' \
'environment=NODE_ENV="production",AUTH_PORT="3011",' \
'    USE_POSTGRESQL="%(ENV_USE_POSTGRESQL)s",DB_HOST="%(ENV_DB_HOST)s",DB_NAME="%(ENV_DB_NAME)s",' \
'    DB_USER="%(ENV_DB_USER)s",DB_PASSWORD="%(ENV_DB_PASSWORD)s",DB_PORT="%(ENV_DB_PORT)s"' \
'stdout_logfile=/dev/stdout' \
'stdout_logfile_maxbytes=0' \
'stderr_logfile=/dev/stderr' \
'stderr_logfile_maxbytes=0' \
'' \
'[program:main-api]' \
'command=node /app/backend/mainApiServer.cjs' \
'directory=/app' \
'priority=40' \
'autostart=true' \
'autorestart=true' \
'startsecs=5' \
'startretries=3' \
'environment=NODE_ENV="production",PORT="3009",GEMINI_API_KEY="%(ENV_GEMINI_API_KEY)s",' \
'    GEMINI_MODEL="%(ENV_GEMINI_MODEL)s",JITSI_DOMAIN="%(ENV_JITSI_DOMAIN)s",GOOGLE_SPEECH_API_KEY="%(ENV_GOOGLE_SPEECH_API_KEY)s",' \
'    USE_POSTGRESQL="%(ENV_USE_POSTGRESQL)s",DB_HOST="%(ENV_DB_HOST)s",DB_NAME="%(ENV_DB_NAME)s",DB_USER="%(ENV_DB_USER)s",' \
'    DB_PASSWORD="%(ENV_DB_PASSWORD)s",DB_PORT="%(ENV_DB_PORT)s"' \
'stdout_logfile=/dev/stdout' \
'stdout_logfile_maxbytes=0' \
'stderr_logfile=/dev/stderr' \
'stderr_logfile_maxbytes=0' > /etc/supervisord.conf

# Runtime credentials (GEMINI_API_KEY, DB_PASSWORD, etc.) injected by Cloud Run / compose — not declared here (S6472).
ENV GEMINI_MODEL=${GEMINI_MODEL:-gemini-3.1-flash-lite} \
    JITSI_DOMAIN=${JITSI_DOMAIN:-meet.jit.si} \
    USE_POSTGRESQL=${USE_POSTGRESQL:-true} \
    DB_HOST=${DB_HOST:-} \
    DB_NAME=${DB_NAME:-} \
    DB_USER=${DB_USER:-} \
    DB_PORT=${DB_PORT:-5432}

# Entrypoint script - copied from repo to avoid bash quoting issues in printf
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    mkdir -p /app/backend/logs /var/secrets/google /app/database

ENV NODE_ENV=production \
    PORT=8080 \
    USE_POSTGRESQL=true \
    USE_EMBEDDED_PG=false \
    DB_HOST=localhost \
    DB_PORT=5432 \
    DB_NAME=izara_phase1 \
    DB_USER=postgres

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080 3009 3011 3012

ENTRYPOINT ["/docker-entrypoint.sh"]
