# Izara Doctor Portal - Environment Configuration
# Generated: 2025-11-24

# ============================================================================
# APPLICATION INFO
# ============================================================================
VITE_APP_NAME=Izara Doctor Portal
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# Main API Server (Clinical operations: EMR, prescriptions, labs, appointments)
VITE_API_URL=http://localhost:3010

# Auth Server (Authentication, sessions, user management)
VITE_AUTH_URL=http://localhost:3011/auth

# Doctor Portal Home (served by Vite on same port as API)
VITE_DOCTOR_URL=http://localhost:3010

# WebSocket for real-time updates
VITE_WEBSOCKET_URL=ws://localhost:3011/ws

# Internal GCS API Server (not exposed to frontend, used by backend only)
GCS_API_URL=http://localhost:3012

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================
VITE_GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_REGION=asia-southeast1

# OAuth 2.0 (for Google Sign-In and API access)
VITE_GOOGLE_CLIENT_ID=xxx
VITE_GOOGLE_CLIENT_SECRET=xxx
VITE_OAUTH_REDIRECT_URI=http://localhost:3010/auth/callback

# Google Cloud Storage Buckets
VITE_GCS_BUCKET_AUTH=izara-users-credentials
VITE_GCS_BUCKET_DOCTOR=izara-doctors-data
VITE_GCS_BUCKET_PATIENT=izara-patients-data
VITE_GCS_BUCKET_APPOINTMENTS=izara-appointments
VITE_GCS_BUCKET_METADATA=izara-meta-data

# ============================================================================
# GOOGLE APIS
# ============================================================================
VITE_GOOGLE_CALENDAR_API_KEY=xxx
VITE_GOOGLE_MEET_API_KEY=xxx
VITE_GOOGLE_MAPS_API_KEY=xxx
# Map ID for AdvancedMarkerElement (optional - suppresses deprecation warnings)
# Create at: Google Cloud Console > Google Maps Platform > Map Management > Create Map ID
# See: https://developers.google.com/maps/documentation/javascript/advanced-markers/start#create-a-map-id
VITE_GOOGLE_MAPS_MAP_ID=

# Google Cloud Speech-to-Text API (for post-meeting transcription)
VITE_GOOGLE_SPEECH_API_KEY=xxx
GOOGLE_SPEECH_API_KEY=xxx

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
VITE_GEMINI_API_KEY=xxx
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_TEMPERATURE=0.7
VITE_GEMINI_MAX_TOKENS=8192

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# PDPA Compliance
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_AUDIT_LOGGING_ENABLED=true

# EMR/EHR Features
VITE_EMR_PATIENT_ACCESS_CONTROL=true
VITE_EMR_AUTO_SAVE_INTERVAL=30000
VITE_EMR_VERSION_CONTROL=true

# Clinical Features
VITE_E_PRESCRIBING_ENABLED=true
VITE_DRUG_INTERACTION_CHECK=true
VITE_LAB_ORDERING_ENABLED=true
VITE_IMAGING_ORDERING_ENABLED=true

# AI Features
VITE_AI_CLINICAL_ASSIST=true
VITE_AI_VOICE_TRANSCRIPTION=true
VITE_AI_NOTE_SUMMARIZATION=true
VITE_AI_ICD_CODING_ASSIST=true
VITE_AI_DRUG_INFO=true

# Other Features
VITE_LIVING_WILL_ENABLED=true
VITE_PHR_WEARABLES_ENABLED=true
VITE_VIDEO_CONSULTATION_ENABLED=true
VITE_QUEUE_MANAGEMENT_ENABLED=true
VITE_REAL_TIME_UPDATES=true

# ============================================================================
# VIDEO MEETING - JITSI MEET (FREE)
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
VITE_JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
VITE_SESSION_TIMEOUT=1800000
VITE_MFA_ENABLED=false
VITE_ENCRYPTION_ENABLED=true

# ============================================================================
# MOBILE/PWA SETTINGS
# ============================================================================
VITE_PWA_ENABLED=true
VITE_OFFLINE_MODE_ENABLED=true
VITE_PUSH_NOTIFICATIONS_ENABLED=true
# ============================================================================
# OPENCLAW MCP SERVER (v2.0 — Doctor AI upgrade)
# ============================================================================
OPENCLAW_MCP_PORT=3016
# 32-byte hex key for AES-256-GCM encryption of PHI payloads
# Generate with: openssl rand -hex 32
OPENCLAW_MCP_ENCRYPTION_KEY=change-me-to-64-char-hex-string-generated-by-openssl-rand-hex-32
# Random secret shared between internal services for request authentication
OPENCLAW_MCP_INTERNAL_SECRET=change-me-to-a-random-64-char-string
# Internal URL of the GCS API server (not exposed externally)
GCS_API_INTERNAL_URL=http://localhost:3012
# Frontend MCP proxy path (proxied by Vite / Nginx)
VITE_MCP_URL=/mcp
VITE_OPENCLAW_MCP_PORT=3016

# ============================================================================
# OMNICHANNEL WEBHOOK SERVER (v2.0 — Doctor AI upgrade)
# ============================================================================
OMNICHANNEL_WEBHOOK_PORT=3015
# Public base URL for consent redirect links
APP_BASE_URL=http://localhost:3010
# Frontend omnichannel proxy path
VITE_OMNICHANNEL_WEBHOOK_URL=/omnichannel
VITE_OMNICHANNEL_WEBHOOK_PORT=3015

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Obtain from: https://developers.line.biz/console/
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
VITE_LINE_ENABLED=false

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Obtain from: https://developers.facebook.com/
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your chosen verification token (any random string)
WHATSAPP_VERIFY_TOKEN=isara_whatsapp_verify
VITE_WHATSAPP_ENABLED=false

# ── Telegram Bot API ──────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Negative group chat ID for care-team Telegram group
TELEGRAM_CARE_TEAM_CHAT_ID=
VITE_TELEGRAM_ENABLED=false

# ── Apple Messages (placeholder for V2) ──────────────────────────────────────
VITE_MESSAGES_ENABLED=false
