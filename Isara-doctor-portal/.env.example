# Izara Doctor Portal - Environment Configuration (template)
# Copy to .env and fill in your values. Only runtime-used variables are listed.

# ============================================================================
# APPLICATION
# ============================================================================
VITE_APP_NAME=Izara Doctor Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development

# ============================================================================
# API / URLS
# ============================================================================
VITE_API_URL=http://localhost:3010
VITE_AUTH_URL=http://localhost:3011/auth
VITE_DOCTOR_URL=http://localhost:3010
VITE_WEBSOCKET_URL=ws://localhost:3011/ws
MEETING_SERVER_URL=http://localhost:3020
VITE_MEETING_SERVER_URL=http://localhost:3020
CORS_ORIGINS=http://localhost:3010,http://localhost:3005,http://localhost:3011

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5433/izara_phase1
DB_HOST=localhost
DB_PORT=5433
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=your-db-password
USE_POSTGRESQL=true

# ============================================================================
# GCP / OAUTH
# ============================================================================
VITE_GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_REGION=asia-southeast1
GCP_PROJECT_ID=izara-telemedicine
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================================================
# GOOGLE APIS
# ============================================================================
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_CALENDAR_API_KEY=your-google-api-key
VITE_GOOGLE_MEET_API_KEY=your-google-api-key
VITE_GOOGLE_SPEECH_API_KEY=your-google-api-key
GOOGLE_SPEECH_API_KEY=your-google-api-key

# ============================================================================
# GEMINI AI — xxxxx = AI disabled until you add a real AIza… key
# ============================================================================
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# ============================================================================
# FEATURE FLAGS (consumed at runtime)
# ============================================================================
VITE_PDPA_ENABLED=true
VITE_AUDIT_LOGGING_ENABLED=true
VITE_EMR_AUTO_SAVE_INTERVAL=30000
VITE_SESSION_TIMEOUT=86400000

# ============================================================================
# JITSI / MEETINGS
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SERVER
# ============================================================================
AUTH_PORT=3011
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-min-32-chars
