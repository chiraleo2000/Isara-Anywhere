{
  "name": "izara-doctor-portal",
  "private": true,
  "version": "1.7.3",
  "description": "Izara Telemedicine Doctor Portal - AI-assisted clinical workflows, EMR/EHR management, and video consultations",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "node server/startAll.cjs",
    "backend:main": "node server/mainApiServer.cjs",
    "backend:auth": "node server/authServer.cjs",
    "backend:gcs": "node server/gcsApiServer.cjs",
    "frontend": "vite --port 3010 --host 0.0.0.0",
    "build": "vite build",
    "build:typecheck": "tsc && vite build",
    "create:buckets": "node scripts/createBuckets.js",
    "docker:build": "docker build -f Dockerfile.unified -t izara-doctor-portal:latest .",
    "docker:build:separate": "docker build -f Dockerfile -t izara-frontend:local . && docker build -f Dockerfile.authserver -t izara-auth:local . && docker build -f Dockerfile.gcsapi -t izara-gcs-api:local .",
    "docker:run": "docker run -p 8080:8080 --env-file .env izara-doctor-portal:latest",
    "docker:push": "docker tag izara-doctor-portal:latest gcr.io/$npm_package_config_gcpProject/izara-doctor-portal:latest && docker push gcr.io/$npm_package_config_gcpProject/izara-doctor-portal:latest",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview --port 3010",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "clean": "rm -rf dist node_modules/.vite",
    "seed": "node scripts/seedUsers.cjs",
    "seed:users": "node scripts/seedUsers.cjs",
    "seed:appointments": "node scripts/seedAppointments.cjs",
    "generate:demo": "node scripts/generateDemoData.cjs",
    "generate:doctors": "node scripts/generateDoctorMockData.cjs",
    "generate:users": "node scripts/generateDoctorUsers.cjs",
    "generate:comprehensive": "node scripts/generateComprehensiveUsers.cjs",
    "generate:all": "npm run generate:demo",
    "upload:gcs": "node scripts/uploadToGCS.cjs",
    "setup:complete": "npm run seed && npm run generate:comprehensive",
    "setup-gcs": "npm run generate:demo && npm run upload:gcs",
    "deploy": "npm run build:prod"
  },
  "config": {
    "bucket": "ultra-mason-473703-h8_uploads"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@google/generative-ai": "^0.21.0",
    "@headlessui/react": "^1.7.17",
    "@react-oauth/google": "^0.13.5",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.16.0",
    "@types/react-router-dom": "^5.3.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^167.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.17.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.5",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.2.43",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.17",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "chromedriver": "^143.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.32",
    "selenium-webdriver": "^4.39.0",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
