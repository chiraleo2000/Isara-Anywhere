# ============================================================================
# DOCTOR PORTAL - CLOUD RUN DOCKERFILE (Unified)
# Optimized for Google Cloud Run with proper PORT handling
# ============================================================================
# 
# Key fixes for Cloud Run:
# 1. Uses PORT environment variable (Cloud Run sets this to 8080)
# 2. Faster health check endpoint
# 3. Improved startup time
# 4. Single port exposure for Cloud Run
#
# Usage:
#   docker build -f Dockerfile.cloudrun -t izara-doctor-portal:cloudrun .
#   gcloud run deploy izara-doctor-portal --image=... --port=8080
# ============================================================================

# =============================================================================
# STAGE 1: Build React Frontend
# =============================================================================
FROM node:22-alpine AS frontend-builder
WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force
COPY . .

# Build-time environment variables for Vite
ARG VITE_APP_NAME="Izara Doctor Portal"
ARG VITE_APP_VERSION="3.0.0"
ARG VITE_APP_ENV="production"
ARG VITE_API_URL
ARG VITE_AUTH_URL
ARG VITE_GCS_API_URL
ARG VITE_DOCTOR_URL
ARG VITE_WEBSOCKET_URL
ARG GCS_API_URL
ARG VITE_GCP_PROJECT_ID=izara-telemedicine
ARG VITE_GCP_REGION=asia-southeast1
ARG VITE_GOOGLE_CLIENT_ID=724889190329-svf2733fjqklfic9tet9d2qkmhkgmu0l.apps.googleusercontent.com
ARG VITE_GCS_BUCKET_AUTH=izara-users-credentials
ARG VITE_GCS_BUCKET_DOCTOR=izara-doctors-data
ARG VITE_GCS_BUCKET_PATIENT=izara-patients-data
ARG VITE_GCS_BUCKET_APPOINTMENTS=izara-appointments
ARG VITE_GCS_BUCKET_METADATA=izara-meta-data
ARG VITE_GEMINI_API_KEY
ARG VITE_GEMINI_MODEL=gemini-2.5-flash
ARG VITE_PDPA_ENABLED=true
ARG VITE_CONSENT_REQUIRED=true
ARG VITE_JITSI_DOMAIN=meet.jit.si

# Set environment variables for Vite build
ENV VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_APP_VERSION=${VITE_APP_VERSION} \
    VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_AUTH_URL=${VITE_AUTH_URL} \
    VITE_GCS_API_URL=${VITE_GCS_API_URL} \
    VITE_DOCTOR_URL=${VITE_DOCTOR_URL} \
    VITE_WEBSOCKET_URL=${VITE_WEBSOCKET_URL} \
    GCS_API_URL=${GCS_API_URL} \
    VITE_GCP_PROJECT_ID=${VITE_GCP_PROJECT_ID} \
    VITE_GCP_REGION=${VITE_GCP_REGION} \
    VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID} \
    VITE_GCS_BUCKET_AUTH=${VITE_GCS_BUCKET_AUTH} \
    VITE_GCS_BUCKET_DOCTOR=${VITE_GCS_BUCKET_DOCTOR} \
    VITE_GCS_BUCKET_PATIENT=${VITE_GCS_BUCKET_PATIENT} \
    VITE_GCS_BUCKET_APPOINTMENTS=${VITE_GCS_BUCKET_APPOINTMENTS} \
    VITE_GCS_BUCKET_METADATA=${VITE_GCS_BUCKET_METADATA} \
    VITE_GEMINI_API_KEY=${VITE_GEMINI_API_KEY} \
    VITE_GEMINI_MODEL=${VITE_GEMINI_MODEL} \
    VITE_PDPA_ENABLED=${VITE_PDPA_ENABLED} \
    VITE_CONSENT_REQUIRED=${VITE_CONSENT_REQUIRED} \
    VITE_JITSI_DOMAIN=${VITE_JITSI_DOMAIN}

RUN npm run build

# =============================================================================
# STAGE 2: Production Runtime
# =============================================================================
FROM node:22-alpine AS production
WORKDIR /app

# Install required packages
RUN apk add --no-cache nginx bash curl gettext supervisor && \
    rm -rf /var/cache/apk/*

# Install production dependencies
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy server and frontend
COPY server/ ./server/
RUN mkdir -p ./public
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Create nginx configuration with PORT substitution
# The nginx will listen on the PORT provided by Cloud Run (default 8080)
RUN cat > /etc/nginx/http.d/default.conf.template << 'NGINX_CONF'
server {
    listen ${NGINX_PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Fast health check endpoint for Cloud Run
    location /health {
        access_log off;
        return 200 '{"status":"healthy","service":"izara-doctor-portal","version":"3.0.0"}';
        add_header Content-Type application/json;
    }

    # API Health check
    location /api/health {
        proxy_pass http://127.0.0.1:3009/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # Auth API routes
    location /api/auth/ {
        proxy_pass http://127.0.0.1:3011/auth/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Storage API routes
    location /api/storage/ {
        proxy_pass http://127.0.0.1:3012/api/storage/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Main API routes
    location /api/ {
        proxy_pass http://127.0.0.1:3009/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Auth routes
    location /auth/ {
        proxy_pass http://127.0.0.1:3011/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Admin routes
    location /admin/ {
        proxy_pass http://127.0.0.1:3011/admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket routes
    location /ws {
        proxy_pass http://127.0.0.1:3011/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    # Static assets with long cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Environment config - no cache
    location /env-config.js {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    error_page 404 /index.html;
}
NGINX_CONF

# Environment config template
RUN cat > /usr/share/nginx/html/env-config.template.js << 'ENVCONFIG'
window.ENV = {
  API_URL: "${VITE_API_URL}",
  AUTH_URL: "${VITE_AUTH_URL}",
  DOCTOR_URL: "${VITE_DOCTOR_URL}",
  WEBSOCKET_URL: "${VITE_WEBSOCKET_URL}",
  GCS_API_URL: "${GCS_API_URL}",
  GCP_PROJECT_ID: "${VITE_GCP_PROJECT_ID}",
  GCP_REGION: "${VITE_GCP_REGION}",
  GOOGLE_CLIENT_ID: "${VITE_GOOGLE_CLIENT_ID}",
  GCS_BUCKET_AUTH: "${VITE_GCS_BUCKET_AUTH}",
  GCS_BUCKET_DOCTOR: "${VITE_GCS_BUCKET_DOCTOR}",
  GCS_BUCKET_PATIENT: "${VITE_GCS_BUCKET_PATIENT}",
  GCS_BUCKET_APPOINTMENTS: "${VITE_GCS_BUCKET_APPOINTMENTS}",
  GCS_BUCKET_METADATA: "${VITE_GCS_BUCKET_METADATA}",
  GEMINI_API_KEY: "${VITE_GEMINI_API_KEY}",
  GEMINI_MODEL: "${VITE_GEMINI_MODEL}",
  PDPA_ENABLED: "${VITE_PDPA_ENABLED}",
  CONSENT_REQUIRED: "${VITE_CONSENT_REQUIRED}",
  JITSI_DOMAIN: "${VITE_JITSI_DOMAIN}"
};
ENVCONFIG

# Supervisor configuration for process management
RUN cat > /etc/supervisord.conf << 'SUPERVISOR'
[supervisord]
nodaemon=true
logfile=/var/log/supervisord.log
pidfile=/var/run/supervisord.pid
loglevel=info

[program:nginx]
command=/usr/sbin/nginx -g "daemon off;"
autostart=true
autorestart=true
startretries=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=1

[program:gcs-api]
command=node /app/server/gcsApiServer.cjs
directory=/app
autostart=true
autorestart=true
startretries=5
environment=NODE_ENV="production",GCS_API_PORT="3012",PORT="3012"
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=2

[program:auth-server]
command=node /app/server/authServer.cjs
directory=/app
autostart=true
autorestart=true
startretries=5
environment=NODE_ENV="production",AUTH_PORT="3011",GCS_API_URL="http://127.0.0.1:3012",VITE_USE_POSTGRESQL="%(ENV_VITE_USE_POSTGRESQL)s",DATABASE_URL="%(ENV_DATABASE_URL)s"
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=3

[program:main-api]
command=node /app/server/mainApiServer.cjs
directory=/app
autostart=true
autorestart=true
startretries=5
environment=NODE_ENV="production",PORT="3009",GCS_API_URL="http://127.0.0.1:3012",GEMINI_API_KEY="%(ENV_GEMINI_API_KEY)s",GEMINI_MODEL="%(ENV_GEMINI_MODEL)s",JITSI_DOMAIN="%(ENV_JITSI_DOMAIN)s",GOOGLE_SPEECH_API_KEY="%(ENV_GOOGLE_SPEECH_API_KEY)s",VITE_USE_POSTGRESQL="%(ENV_VITE_USE_POSTGRESQL)s",DATABASE_URL="%(ENV_DATABASE_URL)s"
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
priority=4
SUPERVISOR

# Entrypoint script with PORT support
RUN cat > /docker-entrypoint.sh << 'ENTRYPOINT'
#!/bin/bash
set -e

echo "=================================================="
echo "Starting Izara Doctor Portal for Cloud Run"
echo "=================================================="
echo "PORT: ${PORT:-8080}"

# Use Cloud Run's PORT or default to 8080
export NGINX_PORT=${PORT:-8080}
echo "Nginx will listen on port: $NGINX_PORT"

# Generate nginx config with correct port
envsubst '${NGINX_PORT}' < /etc/nginx/http.d/default.conf.template > /etc/nginx/http.d/default.conf

# Generate environment config
envsubst < /usr/share/nginx/html/env-config.template.js > /usr/share/nginx/html/env-config.js

# Ensure directories exist
mkdir -p /app/server/logs /var/log /var/run /var/secrets/google

echo "Environment configured"
echo "Starting all services via supervisor..."

exec /usr/bin/supervisord -c /etc/supervisord.conf
ENTRYPOINT

RUN chmod +x /docker-entrypoint.sh && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    mkdir -p /app/server/logs /var/secrets/google

# Environment defaults
ENV NODE_ENV=production \
    PORT=8080 \
    GEMINI_MODEL=gemini-2.5-flash \
    JITSI_DOMAIN=meet.jit.si

# Expose port (Cloud Run will set PORT=8080)
EXPOSE 8080

# Entrypoint
ENTRYPOINT ["/docker-entrypoint.sh"]
