%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E8F5E9',
    'primaryTextColor': '#1B5E20',
    'primaryBorderColor': '#4CAF50',
    'lineColor': '#2E7D32',
    'fontSize': '20px',
    'fontFamily': 'Segoe UI, Arial'
  }
}}%%

flowchart TB
    subgraph VIDEO["📹 VIDEO CONSULTATION"]
        V1["🎥 Jitsi Meeting"]
        V2["🎤 Real-time Transcription"]
        V3["👥 Multi-participant Support"]
    end

    subgraph AI_PROCESS["🤖 AI PROCESSING"]
        A1["📝 Transcript Analysis<br/>(Gemini 2.5 Flash)"]
        A2["📊 Clinical Summary<br/>Generation"]
        A3["💡 Suggested SOAP<br/>Components"]
    end

    subgraph EMR["🩺 EMR DOCUMENTATION"]
        E1["📋 SOAP Notes Template"]
        E2["S: Subjective<br/>(Patient complaints)"]
        E3["O: Objective<br/>(Findings, vitals)"]
        E4["A: Assessment<br/>(Diagnosis, ICD-10)"]
        E5["P: Plan<br/>(Treatment, follow-up)"]
    end

    subgraph ORDERS["📝 CLINICAL ORDERS"]
        O1["💊 E-Prescription"]
        O2["🧪 Lab Orders"]
        O3["🔬 Imaging Orders"]
        O4["📅 Follow-up Appointment"]
    end

    subgraph CDS["⚠️ CLINICAL DECISION SUPPORT"]
        C1["💊 Drug Interaction Check"]
        C2["⚠️ Allergy Alerts"]
        C3["📋 Dosage Validation"]
        C4["✅ Man-in-the-Loop<br/>Approval"]
    end

    subgraph SIGN["✍️ FINALIZATION"]
        S1["👨‍⚕️ Doctor Review"]
        S2["✍️ Digital Signature"]
        S3["🔒 Record Lock"]
        S4["📧 Patient Notification"]
        S5["📁 patient_documents<br/>(emr_report + instruction_sheet)"]
    end

    %% Flow
    V1 --> V2 --> A1
    V3 --> V2
    A1 --> A2 --> A3
    A3 --> E1
    E1 --> E2 --> E3 --> E4 --> E5
    E5 --> O1
    E5 --> O2
    E5 --> O3
    E5 --> O4
    O1 --> C1 --> C2 --> C3 --> C4
    C4 --> S1
    O2 --> S1
    O3 --> S1
    O4 --> S1
    S1 --> S2 --> S3 --> S4 --> S5

    classDef videoStyle fill:#E0F7FA,stroke:#00ACC1,stroke-width:2px,color:#006064
    classDef aiStyle fill:#FFF8E1,stroke:#FFA000,stroke-width:2px,color:#E65100
    classDef emrStyle fill:#E8F5E9,stroke:#388E3C,stroke-width:2px,color:#1B5E20
    classDef orderStyle fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef cdsStyle fill:#FFEBEE,stroke:#E53935,stroke-width:2px,color:#B71C1C
    classDef signStyle fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1

    class V1,V2,V3 videoStyle
    class A1,A2,A3 aiStyle
    class E1,E2,E3,E4,E5 emrStyle
    class O1,O2,O3,O4 orderStyle
    class C1,C2,C3,C4 cdsStyle
    class S1,S2,S3,S4,S5 signStyle
