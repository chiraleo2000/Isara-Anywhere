%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E8F5E9',
    'primaryTextColor': '#1B5E20',
    'primaryBorderColor': '#4CAF50',
    'lineColor': '#2E7D32',
    'fontSize': '20px',
    'fontFamily': 'Segoe UI, Arial'
  }
}}%%

flowchart TB
    subgraph PHR["📋 PERSONAL HEALTH RECORD"]
        direction TB
        
        subgraph BASIC["👤 BASIC INFORMATION"]
            B1["📋 Demographics"]
            B2["📞 Emergency Contacts"]
            B3["🏥 Primary Care Provider"]
        end
        
        subgraph VITALS["💉 VITAL SIGNS"]
            V1["🩸 Blood Pressure"]
            V2["❤️ Heart Rate"]
            V3["🌡️ Temperature"]
            V4["⚖️ Weight / BMI"]
            V5["🫁 SpO2"]
            V6["📊 Trend Charts"]
        end
        
        subgraph MEDS["💊 MEDICATIONS"]
            M1["💊 Current Medications"]
            M2["📅 Dosage Schedule"]
            M3["🔔 Reminders"]
            M4["📜 Prescription History"]
        end
        
        subgraph ALLERGIES["⚠️ ALLERGIES"]
            A1["💊 Drug Allergies"]
            A2["🍎 Food Allergies"]
            A3["🌿 Environmental"]
            A4["⚠️ Severity Level"]
        end
        
        subgraph CONDITIONS["🩺 CONDITIONS"]
            C1["📋 Chronic Conditions"]
            C2["🔬 Past Diagnoses"]
            C3["🏥 Hospitalizations"]
            C4["⚕️ Surgeries"]
        end
        
        subgraph LIVING_WILL["📜 LIVING WILL"]
            L1["⚕️ Medical Directives"]
            L2["🤝 Healthcare Proxy"]
            L3["💉 Treatment Preferences"]
            L4["🔒 Access Control"]
        end
        
        subgraph DOCS["📁 MEDICAL DOCUMENTS"]
            DOC1["📄 patient_documents inbox"]
            DOC2["🧪 Lab / Imaging PDFs"]
            DOC3["💊 Prescriptions"]
            DOC4["📋 EMR reports"]
            DOC5["📤 Patient uploads"]
        end
    end
    
    subgraph AI_FEATURES["🤖 AI FEATURES"]
        AI1["📊 Health Insights"]
        AI2["⚠️ Risk Alerts"]
        AI3["💡 Recommendations"]
    end
    
    subgraph SHARING["🔗 DATA SHARING"]
        S1["👨‍⚕️ Share with Doctor"]
        S2["📧 Export PDF"]
        S3["🔐 Encrypted Transfer"]
    end

    PHR --> AI_FEATURES
    PHR --> SHARING
    DOCS --> S1
    VITALS --> AI1
    CONDITIONS --> AI2
    MEDS --> AI3

    classDef basicStyle fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1
    classDef vitalStyle fill:#FFEBEE,stroke:#E53935,stroke-width:2px,color:#B71C1C
    classDef medStyle fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef allergyStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef conditionStyle fill:#E0F7FA,stroke:#00ACC1,stroke-width:2px,color:#006064
    classDef willStyle fill:#FFF8E1,stroke:#FFA000,stroke-width:2px,color:#E65100
    classDef aiStyle fill:#FFF8E1,stroke:#FFA000,stroke-width:2px,color:#E65100
    classDef shareStyle fill:#E8F5E9,stroke:#388E3C,stroke-width:2px,color:#1B5E20

    class B1,B2,B3 basicStyle
    class V1,V2,V3,V4,V5,V6 vitalStyle
    class M1,M2,M3,M4 medStyle
    class A1,A2,A3,A4 allergyStyle
    class C1,C2,C3,C4 conditionStyle
    class L1,L2,L3,L4 willStyle
    class DOC1,DOC2,DOC3,DOC4,DOC5 willStyle
    class AI1,AI2,AI3 aiStyle
    class S1,S2,S3 shareStyle
