%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E8F5E9',
    'primaryTextColor': '#1B5E20',
    'primaryBorderColor': '#4CAF50',
    'lineColor': '#2E7D32',
    'secondaryColor': '#E3F2FD',
    'tertiaryColor': '#FFF3E0',
    'fontSize': '22px',
    'fontFamily': 'Segoe UI, Arial'
  }
}}%%

flowchart TB
    subgraph DP["💻 DOCTOR PORTAL"]
        direction TB
        
        subgraph AUTH["🔐 Authentication"]
            A1["Login"]
            A2["Doctor Registration<br/>(Pending Approval)"]
            A3["Profile & Credentials"]
        end
        
        subgraph QUEUE["📋 Queue Management"]
            B1["📅 Today's Appointments"]
            B2["⏳ Pending Requests"]
            B3["✅ Confirm / ❌ Reject"]
            B4["📊 Patient Queue"]
        end
        
        subgraph CONSULT["📹 Consultation"]
            C1["🎥 Jitsi Video Call"]
            C2["🎤 AI Transcription"]
            C3["📝 Real-time Notes"]
            C4["👥 Multi-participant"]
        end
        
        subgraph EMR["🩺 EMR System"]
            D1["📋 SOAP Notes"]
            D2["🔍 Patient History"]
            D3["📊 AI Summary"]
            D4["✍️ Doctor Signature"]
        end
        
        subgraph PRESCRIBE["💊 Prescribing"]
            E1["💊 E-Prescription"]
            E2["⚠️ Drug Interaction Check"]
            E3["🔔 CDS Alerts"]
            E4["✅ Man-in-the-Loop"]
        end
        
        subgraph ORDERS["🧪 Orders"]
            F1["🧪 Lab Orders"]
            F2["🔬 Imaging Orders"]
            F3["📊 Result Review"]
            F4["🤖 AI Analysis"]
            F5["📁 patient_documents delivery"]
        end
        
        subgraph MESSAGES["💬 Patient Messaging"]
            H1["✉️ Email / Message Patient"]
            H2["patient_doctor_messages"]
        end
        
        subgraph ADMIN["🔧 Admin Panel"]
            G1["👨‍⚕️ Doctor Approval"]
            G2["📝 Content Management"]
            G3["📊 Analytics"]
            G4["⚙️ System Settings"]
        end
    end

    A1 --> B1
    B1 --> B4 --> C1
    C1 --> C2 --> D1
    D1 --> D3 --> D4
    D1 --> E1 --> E2 --> E3 --> E4
    D1 --> F1
    D4 --> H1 --> H2
    F3 --> F5
    A1 --> G1

    classDef authStyle fill:#FFEBEE,stroke:#E53935,stroke-width:2px,color:#B71C1C
    classDef queueStyle fill:#E3F2FD,stroke:#1976D2,stroke-width:2px,color:#0D47A1
    classDef consultStyle fill:#E0F7FA,stroke:#00ACC1,stroke-width:2px,color:#006064
    classDef emrStyle fill:#E8F5E9,stroke:#388E3C,stroke-width:2px,color:#1B5E20
    classDef rxStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef orderStyle fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef adminStyle fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#37474F

    class A1,A2,A3 authStyle
    class B1,B2,B3,B4 queueStyle
    class C1,C2,C3,C4 consultStyle
    class D1,D2,D3,D4 emrStyle
    class E1,E2,E3,E4 rxStyle
    class F1,F2,F3,F4,F5 orderStyle
    class H1,H2 queueStyle
    class G1,G2,G3,G4 adminStyle
