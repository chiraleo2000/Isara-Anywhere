{
  "name": "izara-jitsi-server",
  "version": "1.7.33",
  "description": "Izara Jitsi Meeting Server - Video, Transcription (Web Speech API), AI Summary (Gemini)",
  "main": "backend/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon backend/index.js",
    "start": "node backend/index.js",
    "build": "echo 'No build step required'",
    "docker:build": "docker build -t izara-jitsi-server .",
    "db:init:standalone": "node scripts/database/init-standalone.mjs",
    "db:seed:standalone": "node scripts/database/seed-standalone.mjs",
    "test:smoke:e2e": "node scripts/run-standalone-tests.mjs",
    "test:standalone": "node scripts/run-standalone-tests.mjs",
    "docker:run": "docker run -p 3020:3020 --env-file .env izara-jitsi-server"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.0.0",
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.17.2",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "author": "Izara Telemedicine",
  "license": "MIT"
}
