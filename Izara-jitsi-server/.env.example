# ============================================================================
# IZARA JITSI MEETING SERVER - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# APPLICATION INFO
# ============================================================================
NODE_ENV=development
PORT=3020

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL (shared with Izara portals)
# ============================================================================
DATABASE_URL=postgresql://postgres:P@ssw0rd@localhost:5432/izara_phase1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=P@ssw0rd

# ============================================================================
# JITSI MEET CONFIGURATION
# ============================================================================
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
JITSI_API_KEY=
JITSI_INTERNAL_URL=http://jitsi-web:80
JITSI_ENABLE_LOBBY=true
JITSI_ENABLE_PREJOIN=true
JITSI_DEFAULT_LANGUAGE=th
JITSI_START_WITH_AUDIO_MUTED=false
JITSI_START_WITH_VIDEO_MUTED=false

# ============================================================================
# GOOGLE CLOUD SPEECH-TO-TEXT
# ============================================================================
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
# Cloud Run secret: base64-encoded service account JSON (preferred for STT diarization)
GCP_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_CLOUD_SPEECH_API_KEY

# Speech-to-Text Configuration
GOOGLE_STT_ENABLED=true
GOOGLE_STT_LANGUAGE=th-TH
GOOGLE_STT_MODEL=latest_long
GOOGLE_STT_SAMPLE_RATE=16000
GOOGLE_STT_ENCODING=LINEAR16
GOOGLE_STT_ENABLE_WORD_TIME_OFFSETS=true
GOOGLE_STT_ENABLE_AUTOMATIC_PUNCTUATION=true
GOOGLE_STT_STREAMING_ENABLED=true
GOOGLE_STT_STREAMING_TIMEOUT=300

# Alternative languages (comma-separated)
GOOGLE_STT_ALTERNATIVE_LANGUAGES=en-US

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=8192

# AI Summary Configuration
AI_SUMMARY_INTERVAL_MINUTES=30
AI_SUMMARY_MIN_WORDS=100
AI_SUMMARY_LANGUAGE=th

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET=izara-jitsi-jwt-secret-key-phase1-2026
JWT_EXPIRES_IN=24h

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3020

# ============================================================================
# POST-MEETING PIPELINE (Jibri / MediaRecorder → Whisper → Gemini → EMR)
# ============================================================================
RECORDINGS_DIR=./recordings
RECORDING_ENCRYPTION_KEY=
# Falls back to scrypt(JWT_SECRET) when RECORDING_ENCRYPTION_KEY is empty
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_MS=300000
JIBRI_WEBHOOK_SECRET=
GCS_BUCKET=
POST_MEETING_PIPELINE_TIMEOUT_MS=900000
PIPELINE_RETRY_MAX=3
PIPELINE_RETRY_BASE_MS=500
MIN_RECORDING_BYTES=1024

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# CLOUD RUN PRODUCTION CONFIGURATION
# ============================================================================
CLOUD_RUN_REGION=asia-southeast1
CLOUD_RUN_MEMORY=1Gi
CLOUD_RUN_CPU=2
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=5
