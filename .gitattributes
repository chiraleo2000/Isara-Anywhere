# Large documentation and screenshot assets — Git LFS (keeps push packs under ADO HTTP limits)
*.pptx filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
Documents/docs/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text

# Shell scripts must use LF on Ubuntu (CRLF breaks `set -euo pipefail`)
*.sh text eol=lf
deploy/nginx/** text eol=lf
