        B2["📋 My Appointments<br/>รายการนัดหมาย"]
        B3["📹 Video Call<br/>Jitsi Meet"]
    end

    subgraph PHR["📋 HEALTH RECORDS"]
        P1["📊 PHR Dashboard<br/>ข้อมูลสุขภาพ"]
        P2["💊 Medications<br/>รายการยา"]
        P3["⚠️ Allergies<br/>ประวัติแพ้ยา"]
        P4["📈 Vitals<br/>สัญญาณชีพ"]
    end

    subgraph HEALTH["🏥 HEALTH STUDIO"]
        H1["🤖 AI Health Chat<br/>Gemini AI"]
        H2["📚 Medical Library<br/>คลังความรู้"]
        H3["📋 Treatment Results<br/>ผลการรักษา"]
    end

    subgraph EXTRA["🔧 UTILITIES"]
        M1["🗺️ Healthcare Map<br/>แผนที่รพ."]
