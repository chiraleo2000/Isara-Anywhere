    classDef centerStyle fill:#E3F2FD,stroke:#2196F3,stroke-width:3px,color:#0D47A1
    classDef bookingStyle fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#1B5E20
    classDef phrStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef healthStyle fill:#F3E5F5,stroke:#9C27B0,stroke-width:2px,color:#4A148C
    classDef extraStyle fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#37474F

    class HOME centerStyle
    class B1,B2,B3 bookingStyle
    class P1,P2,P3,P4 phrStyle
    class H1,H2,H3 healthStyle
    class M1,PR1,PR2,LW extraStyle

