flowchart TB
    subgraph LOCAL["💻 LOCAL DEVELOPMENT"]
        direction TB
        L1["🐳 Docker Compose"]
        L2["📱 Patient Portal<br/>localhost:3005"]
        L3["💻 Doctor Portal<br/>localhost:3010"]
        L4["📹 Meeting Server<br/>localhost:3020"]
        L5["🗄️ PostgreSQL 18<br/>localhost:5433"]
        L6["🔧 pgAdmin 4<br/>localhost:5050"]
    end

    subgraph MOBILE_DEV["📱 MOBILE DEVELOPMENT"]
        direction LR
        MD1["📲 Expo 52 Dev Server<br/>localhost:8081"]
        MD2["🤖 Android Studio<br/>Emulator"]
        MD3["🍎 iOS Simulator<br/>Xcode"]
        MD4["🧪 Playwright Mobile<br/>Viewport Testing"]
    end

    subgraph CLI["⚡ UNIFIED CLI (izara-cli.ps1)"]
        direction LR
        C1["🚀 start"]
        C2["🛑 stop"]
        C3["🗄️ db"]
        C4["🔄 reset"]
        C5["🧪 test"]
    end

    subgraph GCP["☁️ GOOGLE CLOUD PLATFORM"]
        direction TB
        subgraph CLOUDRUN["🚀 Cloud Run (asia-southeast1)"]
            CR1["📱 patient-portal-service"]
            CR2["💻 doctor-portal-service"]
            CR3["📹 jitsi-server-service"]
        end
        subgraph STORAGE["📦 Cloud Storage"]
            S1["📄 izara-documents"]
            S2["🖼️ izara-images"]
            S3["🎥 izara-recordings"]
            S4["🧪 izara-lab-results"]
            S5["🔬 izara-imaging-results"]
        end
        subgraph DATABASE["🗄️ Cloud SQL VM"]
            DB1[("🐘 PostgreSQL 18<br/>+ pgvector<br/>35.240.157.230:5432")]
        end
        subgraph PGADMIN["🔧 pgAdmin"]
            PA1["pgAdmin 4<br/>Cloud Run Service"]
        end
    end

    subgraph CICD["🔄 CI/CD PIPELINE"]
        direction LR
        CI1["📝 Cloud Build<br/>cloudbuild.yaml"]
        CI2["🐳 Artifact Registry<br/>asia-southeast1-docker"]
        CI3["🚀 Deploy to Cloud Run<br/>v1.5.10"]
    end

    subgraph TESTING["🧪 TESTING (215 Cloud Tests)"]
        direction LR
        T1["📸 UI Screenshots: 39"]
        T2["🔄 Multi-User Workflows: 42"]
        T3["📹 Meeting Tests: 27"]
        T4["📋 Workflow Screenshots: 25"]
        T5["📄 UI Pages: 44"]
    end

    %% Local Development Flow
    CLI --> L1
    L1 --> L2
    L1 --> L3
    L1 --> L4
    L1 --> L5
    L1 --> L6

    %% Mobile Development Flow
    MD1 --> L2
    MD1 --> L3
    MD1 --> L4
    MD2 -.-> MD1
    MD3 -.-> MD1
    MD4 -.-> L2
    MD4 -.-> L3

    %% CI/CD Flow
    CI1 --> CI2 --> CI3
    CI3 --> CLOUDRUN

    %% Cloud Run connections
    CR1 --> DB1
    CR2 --> DB1
    CR3 --> DB1
    CR1 --> STORAGE
    CR2 --> STORAGE
    CR3 --> STORAGE
    PA1 --> DB1

    %% Testing connects to Cloud Run
    TESTING -.-> CLOUDRUN

