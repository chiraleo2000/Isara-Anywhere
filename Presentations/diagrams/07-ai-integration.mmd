        direction TB
        P1["💬 Health Assistant Chat"]
        P2["📄 Document Analysis<br/>(Medical Records)"]
        P3["🔍 Symptom Assessment<br/>& Triage"]
        P4["❓ Health Q&A"]
    end

    subgraph DOCTOR_AI["💻 DOCTOR PORTAL AI"]
        direction TB
        D1["📝 Transcript Summary"]
        D2["📋 SOAP Note Suggestions"]
        D3["💊 CDS Recommendations"]
        D4["📊 Patient History Analysis"]
    end

    subgraph MEETING_AI["📹 VIDEO MEETING AI"]
        direction TB
        M1["🎤 Web Speech API<br/>(Browser-based STT)"]
        M2["📝 Live Transcription<br/>(Socket.IO Broadcast)"]
        M3["🌐 Multi-language Support"]
        M4["🧠 SOAP Summary<br/>(Gemini Post-Meeting)"]
    end

    subgraph SAFETY["⚠️ SAFETY MEASURES"]
        direction TB
        S1["👨‍⚕️ Man-in-the-Loop"]
        S2["⚠️ Medical Disclaimer"]
        S3["🔒 No Diagnosis/Rx<br/>Without Doctor"]
        S4["📋 Audit Logging"]
    end

    subgraph DATA_CONTEXT["📊 CONTEXT SOURCES"]
        direction TB
        C1["📋 Patient PHR"]
        C2["💊 Medication History"]
        C3["🩺 Allergy Information"]
        C4["📖 Encounter History"]
    end

    %% Connections
    GEMINI --> PATIENT_AI
    GEMINI --> DOCTOR_AI
