    DATA_CONTEXT --> P1
    DATA_CONTEXT --> P3
    DATA_CONTEXT --> D1
    DATA_CONTEXT --> D2
    DATA_CONTEXT --> D3

    M1 --> M2
    M2 --> D1
    M2 --> M4

    D1 --> D2 --> D3
    D3 --> S1

    P3 --> S2
    P4 --> S3

    DOCTOR_AI --> S4

