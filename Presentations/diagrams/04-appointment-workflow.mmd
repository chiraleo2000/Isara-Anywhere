%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E3F2FD',
    'primaryTextColor': '#0D47A1',
    'primaryBorderColor': '#2196F3',
    'lineColor': '#1976D2',
    'secondaryColor': '#E8F5E9',
    'tertiaryColor': '#FFF8E1',
    'fontSize': '28px',
    'fontFamily': 'Segoe UI, Arial'
  }
}}%%

flowchart LR
    subgraph PATIENT["👤 PATIENT"]
        direction TB
        P1["🔐 Login"]
        P2["🩺 Enter Symptoms"]
        P3["👨‍⚕️ Select Doctor"]
        P4["📅 Select Slot"]
        P5["✅ Confirm"]
        P1 --> P2 --> P3 --> P4 --> P5
    end

    subgraph SYSTEM["⚙️ SYSTEM"]
        direction TB
        S1["🤖 AI Analysis<br/>Gemini"]
        S2["💾 Save to GCS<br/>izara-appointments"]
        S3["📧 Notify Doctor"]
    end

    subgraph DOCTOR["👨‍⚕️ DOCTOR"]
        direction TB
        D1["👀 Review"]
        D2{{"Decision"}}
        D3["✅ Accept"]
        D4["❌ Reject"]
        D1 --> D2
        D2 -->|Yes| D3
        D2 -->|No| D4
    end

    subgraph RESULT["🎉 RESULT"]
        direction TB
        R1["📹 Jitsi Link"]
        R2["📧 Notify Patient"]
        R3["✅ Confirmed"]
        R1 --> R2 --> R3
    end

    P2 -.-> S1
    P5 --> S2 --> S3 --> D1
    D3 --> R1
    D4 --> END(["❌ Cancelled"])

    classDef patientStyle fill:#E3F2FD,stroke:#2196F3,stroke-width:2px,color:#0D47A1
    classDef systemStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef doctorStyle fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#1B5E20
    classDef resultStyle fill:#E0F7FA,stroke:#00BCD4,stroke-width:2px,color:#006064
    classDef decisionStyle fill:#FFF8E1,stroke:#FFC107,stroke-width:2px,color:#FF6F00

    class P1,P2,P3,P4,P5 patientStyle
    class S1,S2,S3 systemStyle
    class D1,D3,D4 doctorStyle
    class D2 decisionStyle
    class R1,R2,R3 resultStyle

