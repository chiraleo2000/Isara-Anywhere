%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E3F2FD',
    'primaryTextColor': '#0D47A1',
    'primaryBorderColor': '#2196F3',
    'lineColor': '#1976D2',
    'secondaryColor': '#E8F5E9',
    'tertiaryColor': '#FFF3E0',
    'fontSize': '28px',
    'fontFamily': 'Segoe UI, Arial'
  }
}}%%

flowchart LR
    subgraph INIT["🔧 INIT"]
        A1["👤 Select Patient"]
        A2["📂 Query DB<br/>phr"]
        A3["⚠️ Allergies"]
    end

    subgraph SEARCH["🔍 SEARCH"]
        B1["💊 Drug Name"]
        B2["📖 Database"]
        B3["📋 View Info"]
    end

    subgraph SAFETY["🛡️ SAFETY"]
        C1["⚔️ Interaction"]
        C2["⚠️ Contraindication"]
        C3["📏 Dose Check"]
    end

    subgraph PRESCRIBE["📝 PRESCRIBE"]
        D1["✍️ Select Drug"]
        D2["🔢 Dosage"]
        D3["📅 Duration"]
        D4["📝 Instructions"]
    end

    subgraph FINALIZE["✅ FINALIZE"]
        E1["👀 Review"]
        E2["✍️ Digital Sign"]
        E3["💾 Save to DB<br/>prescriptions"]
        E4["🔔 Notify Patient"]
        E5["🏪 Send Pharmacy"]
    end

    %% Linear flow
    A1 --> A2 --> A3
    A3 --> B1 --> B2 --> B3
    B3 --> C1 --> C2 --> C3
    C3 --> D1 --> D2 --> D3 --> D4
    D4 --> E1 --> E2 --> E3 --> E4 --> E5

    %% Styling
    classDef initStyle fill:#E3F2FD,stroke:#2196F3,stroke-width:2px,color:#0D47A1
    classDef searchStyle fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#1B5E20
    classDef safetyStyle fill:#FFEBEE,stroke:#F44336,stroke-width:2px,color:#B71C1C
    classDef prescribeStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef finalizeStyle fill:#E0F7FA,stroke:#00BCD4,stroke-width:2px,color:#006064

    class A1,A2,A3 initStyle
    class B1,B2,B3 searchStyle
    class C1,C2,C3 safetyStyle
    class D1,D2,D3,D4 prescribeStyle
    class E1,E2,E3,E4,E5 finalizeStyle
