flowchart LR
    subgraph TITLE["🔄 DATA FLOW ARCHITECTURE<br/>สถาปัตยกรรมการไหลของข้อมูล"]
        direction TB
    end

    subgraph CLIENTS["💻 CLIENTS"]
        P_APP["📱 Patient Portal"]
        D_APP["💻 Doctor Portal"]
    end

    subgraph API["⚙️ API GATEWAY"]
        LB["⚖️ Load Balancer"]
        BE_SVC["🚀 Backend Service"]
    end

    subgraph DATA["💾 DATA LAYER"]
        PG["🐘 PostgreSQL<br/>(Transactional Data)"]
        GCS["📦 GCS Buckets<br/>(File Storage)"]
    end

    %% Flow
    P_APP -->|REST API| LB
    D_APP -->|REST API| LB
    LB --> BE_SVC
    
    BE_SVC -->|Query/Update| PG
    BE_SVC -->|Upload/Download| GCS

    %% Styling
    classDef clientStyle fill:#E3F2FD,stroke:#2196F3,stroke-width:2px,color:#0D47A1
    classDef apiStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef dataStyle fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#1B5E20
    
    class P_APP,D_APP clientStyle
    class LB,BE_SVC apiStyle
    class PG,GCS dataStyle
