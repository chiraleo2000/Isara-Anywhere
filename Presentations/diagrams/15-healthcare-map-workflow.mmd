%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#E0F7FA',
    'primaryTextColor': '#006064',
    'primaryBorderColor': '#00BCD4',
    'lineColor': '#00ACC1',
    'secondaryColor': '#E8F5E9',
    'tertiaryColor': '#FFF3E0',
    'fontSize': '28px',
    'fontFamily': 'Segoe UI, Arial'
