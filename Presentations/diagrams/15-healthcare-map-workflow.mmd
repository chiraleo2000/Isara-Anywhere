flowchart LR
    subgraph INIT["🔧 INIT"]
        A1["🗺️ Load Map"]
        A2["📍 Get Location"]
        A3["🔐 Permission"]
    end

    subgraph SEARCH["🔍 SEARCH"]
        B1["🔤 By Name"]
        B2["📍 By Area"]
        B3["🏥 By Specialty"]
    end

    subgraph FILTER["⚙️ FILTERS"]
        C1["🏥 Facility Type<br/>Hospital/Clinic/Pharmacy"]
        C2["📏 Distance<br/>5km/10km/20km"]
        C3["⭐ Rating"]
        C4["🕐 Open Now"]
    end

    subgraph RESULTS["📋 RESULTS"]
        D1["📍 Show Markers"]
        D2["📋 Show List"]
        D3["↕️ Sort Results"]
    end

    subgraph DETAILS["📄 DETAILS"]
        E1["ℹ️ Info"]
        E2["🕐 Hours"]
        E3["🏥 Services"]
        E4["⭐ Reviews"]
    end

    subgraph ACTIONS["⚡ ACTIONS"]
        F1["🚗 Get Directions"]
        F2["📞 Call"]
        F3["⭐ Save Favorite"]
        F4["📅 Book Appointment"]
    end

    %% Flows
    A1 --> A2 --> A3
    A3 --> B1 --> D1
    A3 --> B2 --> D1
    A3 --> B3 --> D1
    D1 --> C1 --> C2 --> C3 --> C4 --> D2
    D2 --> D3 --> E1 --> E2 --> E3 --> E4
    E4 --> F1 --> F2 --> F3 --> F4

    %% Styling
    classDef initStyle fill:#E0F7FA,stroke:#00BCD4,stroke-width:2px,color:#006064
    classDef searchStyle fill:#E3F2FD,stroke:#2196F3,stroke-width:2px,color:#0D47A1
    classDef filterStyle fill:#FFF3E0,stroke:#FF9800,stroke-width:2px,color:#E65100
    classDef resultStyle fill:#E8F5E9,stroke:#4CAF50,stroke-width:2px,color:#1B5E20
    classDef detailStyle fill:#F3E5F5,stroke:#9C27B0,stroke-width:2px,color:#4A148C
    classDef actionStyle fill:#FFF8E1,stroke:#FFC107,stroke-width:2px,color:#FF6F00

    class A1,A2,A3 initStyle
    class B1,B2,B3 searchStyle
    class C1,C2,C3,C4 filterStyle
    class D1,D2,D3 resultStyle
    class E1,E2,E3,E4 detailStyle
    class F1,F2,F3,F4 actionStyle

