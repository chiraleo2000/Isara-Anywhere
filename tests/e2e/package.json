{
  "name": "isara-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for Isara Telemedicine Platform",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:local": "cross-env TEST_ENV=local npx playwright test",
    "test:cloud": "cross-env TEST_ENV=cloud npx playwright test",
    "test:appointment": "npx playwright test appointment-workflow.spec.ts --headed",
    "test:meeting": "npx playwright test meeting-workflow.spec.ts --headed",
    "test:api": "npx playwright test api-status.spec.ts",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cross-env": "^7.0.3"
  }
}
