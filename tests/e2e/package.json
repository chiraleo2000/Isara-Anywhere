{
  "name": "isara-e2e-tests",
  "version": "6.0.0",
  "description": "E2E tests for Isara Telemedicine Platform — Comprehensive v6 (14 spec files, 400+ tests)",
  "scripts": {
    "test": "npx playwright test --project=Local --headed",
    "smoke": "npx playwright test specs/01-smoke.spec.ts --headed",
    "api": "npx playwright test specs/02-api-status.spec.ts --headed",
    "appointment": "npx playwright test specs/03-appointment-workflow.spec.ts --headed",
    "meeting": "npx playwright test specs/04-meeting-workflow.spec.ts --headed",
    "health": "npx playwright test specs/05-health-records-emr.spec.ts --headed",
    "ai": "npx playwright test specs/06-ai-features.spec.ts --headed",
    "ui": "npx playwright test specs/07-ui-navigation.spec.ts --headed",
    "content": "npx playwright test specs/08-content-notifications.spec.ts --headed",
    "cloud": "cross-env TEST_ENV=cloud npx playwright test --project=Cloud --headed",
    "local": "npx playwright test --project=Local --headed",
    "full": "npx playwright test --project=Local --headed --workers=4",
    "all": "npx playwright test --project=All --headed --workers=4",
    "local-full": "npx playwright test specs/13-full-workflow-local.spec.ts --headed --workers=4",
    "cloud-full": "cross-env TEST_ENV=cloud npx playwright test specs/14-full-workflow-cloud.spec.ts --headed --workers=4",
    "phase1": "npx playwright test specs/11-phase1-requirements.spec.ts --headed",
    "comprehensive": "npx playwright test specs/10-comprehensive-workflows.spec.ts --headed",
    "local-all": "npx playwright test specs/13-full-workflow-local.spec.ts specs/01-smoke.spec.ts specs/02-api-status.spec.ts --headed --workers=4",
    "cloud-all": "cross-env TEST_ENV=cloud npx playwright test specs/14-full-workflow-cloud.spec.ts specs/09-cloud-e2e.spec.ts --headed --workers=4",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cross-env": "^7.0.3"
  }
}
