{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@doctor/*": ["../../Isara-doctor-portal/frontend/*"],
      "@patient/*": ["../../Isara-patient-portal/frontend/*"],
      "@meeting/*": ["../../Izara-jitsi-server/backend/*"]
    }
  },
  "include": ["./**/*.ts", "./vitest-env.d.ts"],
  "exclude": ["node_modules"]
}
