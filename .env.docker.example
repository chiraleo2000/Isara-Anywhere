# ============================================================================
# IZARA TELEMEDICINE - DOCKER COMPOSE ENVIRONMENT (EXAMPLE)
# Version: 3.3.0 · Updated: 2026-06-22
# ============================================================================
# Copy to .env.docker and replace placeholders. File is gitignored.
#
#   Mode A localhost:  cp .env.docker.example .env.docker
#   Mode B LAN HTTP:   cp .env.docker.lan.example .env.docker
#   Mode B LAN HTTPS:  cp .env.docker.lan.https.example .env.docker
#
# Guides: deploy/nginx/DEPLOYMENT.md
# ============================================================================

# --- Application ---
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production
NODE_ENV=production

# --- Postgres ---
# Host path for DB files (bind mount). Windows/dev: ./data/postgres · Ubuntu LAN: /var/lib/izara/postgres
# Omit this line to use Docker named volume postgres_data instead.
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword
DATABASE_URL=postgresql://postgres:YourSecurePassword@postgres:5432/izara_phase1
DB_HOST=postgres
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=YourSecurePassword
DB_SSL=false
USE_POSTGRESQL=true

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# --- OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Mode A browser URLs (localhost) ---
VITE_API_URL=
VITE_AUTH_PORTAL_URL=http://localhost:3005/auth
VITE_PATIENT_URL=http://localhost:3005/home
VITE_WEBSOCKET_URL=ws://localhost:3005/ws
VITE_AUTH_URL=
OAUTH_REDIRECT_URI=http://localhost:3005/auth/callback

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_MEET_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
VITE_GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY

# --- Gemini (xxxxx = AI disabled) ---
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VITE_GEMINI_TEMPERATURE=0.3
VITE_GEMINI_MAX_TOKENS=8192

# --- Meeting ---
MEETING_SERVER_URL=http://meeting-server:3020
MEETING_PUBLIC_URL=http://127.0.0.1:3020
VITE_MEETING_SERVER_URL=http://localhost:3020
PATIENT_PORTAL_URL=http://127.0.0.1:3005
DOCTOR_PORTAL_URL=http://127.0.0.1:3010
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3020,http://127.0.0.1:3005,http://127.0.0.1:3010,http://127.0.0.1:3020,http://host.docker.internal:3005,http://host.docker.internal:3010,http://host.docker.internal:3020

# --- Demo auto-login (doctor/patient portals — silent session for local/docker/cloud demo) ---
DEMO_AUTO_LOGIN=1
DEMO_AUTO_MEETING=1
DEMO_DOCTOR_EMAIL=doctor.test@izara.com
DEMO_DOCTOR_PASSWORD=IzaraDoctor@2024
DEMO_PATIENT_EMAIL=demo.test@gmail.com
DEMO_PATIENT_PASSWORD=P@ssw0rd

# Doctor must click Admit in lobby (set 1 only for automated E2E gate runs)
VITE_AUTO_ADMIT_LOBBY=0

# --- Jitsi (self-hosted local: meet.localhost; public dev fallback: meet.jit.si) ---
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
JITSI_JWT_SECRET=your-jitsi-jwt-secret-min-32-chars-sync-with-deploy-jitsi-env
VITE_JITSI_ENABLE_LOBBY=true
VITE_JITSI_ENABLE_PREJOIN=true

# --- Security ---
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=3h
SESSION_EXPIRES_IN=7d
RECORDING_ENCRYPTION_KEY=your-recording-encryption-key-min-32-chars
JIBRI_WEBHOOK_SECRET=your-jibri-webhook-secret
VITE_SESSION_TIMEOUT=1800000
VITE_MFA_ENABLED=false
VITE_ENCRYPTION_ENABLED=true

# --- Feature flags (Vite build) ---
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_AUDIT_LOGGING_ENABLED=true
VITE_VIDEO_CONSULTATION_ENABLED=true
VITE_REAL_TIME_UPDATES=true
VITE_USE_POSTGRESQL=true

# --- PWA ---
VITE_PWA_ENABLED=true
VITE_OFFLINE_MODE_ENABLED=true
VITE_PUSH_NOTIFICATIONS_ENABLED=true

# --- Ops ---
E2E_ALLOW_PARALLEL_SESSIONS=1
RATE_LIMIT_MAX=2000
