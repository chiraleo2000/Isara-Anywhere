# ============================================================================
# IZARA TELEMEDICINE - DOCKER COMPOSE ENVIRONMENT (EXAMPLE)
# Version: 3.2.0
# Updated: 2026-06-18
# ============================================================================
# Copy this file to .env.docker and replace with your actual API keys
# DO NOT commit .env.docker with real API keys to version control!
#
# Canonical server names below; docker-compose bridges to VITE_* build-args.
# ============================================================================

# ============================================================================
# POSTGRES DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# ============================================================================
# GOOGLE APIs - REPLACE WITH YOUR OWN KEYS
# ============================================================================
# Get your API keys from: https://console.cloud.google.com/apis/credentials

# Google Maps API (server canonical; compose bridges to VITE_GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID

# Google Calendar & Meet API (client-only)
VITE_GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_CALENDAR_API_KEY
VITE_GOOGLE_MEET_API_KEY=YOUR_GOOGLE_MEET_API_KEY

# Google Cloud Speech-to-Text API (server-only)
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY

# ============================================================================
# GEMINI AI CONFIGURATION — xxxxx = AI disabled until you add a real AIza… key
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ============================================================================
# MEETING SERVER
# ============================================================================
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=http://localhost:3020
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3020,http://host.docker.internal:3005,http://host.docker.internal:3010,http://host.docker.internal:3020

# ============================================================================
# JITSI CONFIGURATION
# JITSI_ENABLE_LOBBY/PREJOIN in jitsi-server .env are informational only;
# Izara lobby is enforced in meeting-server code (Jitsi lobby disabled).
# ============================================================================
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
VITE_JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-secure-jwt-secret-key-change-this
RECORDING_ENCRYPTION_KEY=your-recording-encryption-key-min-32-chars
JIBRI_WEBHOOK_SECRET=your-jibri-webhook-secret

# ============================================================================
# DATABASE FLAGS
# ============================================================================
USE_POSTGRESQL=true
