# Izara Docker Compose — canonical secrets (gitignored)
# npm run env:sync  →  portal .env + root .env for npm dev
# No VITE_* keys — client vars use canonical names (API_URL, GCP_REGION, etc.)

# --- App ---
APP_NAME=Izara Patient Portal
APP_VERSION=2.0.0
APP_ENV=production
NODE_ENV=production

# --- Postgres ---
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxx
POSTGRES_DB=izara_phase1
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=xxxxx
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/izara_phase1
DB_HOST=postgres
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=xxxxx
DB_SSL=false
USE_POSTGRESQL=true

# --- GCP ---
GCP_PROJECT_ID=izara-telemedicine
GCP_REGION=asia-southeast1

# --- OAuth ---
GOOGLE_CLIENT_ID=724889190329-svf2733fjqklfic9tet9d2qkmhkgmu0l.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
OAUTH_REDIRECT_URI=http://localhost:3005/auth/callback

# --- Browser / SPA (localhost docker; use .env.docker.lan* for Nginx hostnames) ---
API_URL=
AUTH_PORTAL_URL=http://localhost:3005/auth
PATIENT_APP_URL=http://localhost:3005/home
AUTH_URL=http://localhost:3011/auth
DOCTOR_APP_URL=http://localhost:3010
WEBSOCKET_URL=ws://localhost:3005/ws

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=xxxxx
GOOGLE_MAPS_MAP_ID=60687d30be2fe4b7e600b274
GOOGLE_SPEECH_API_KEY=xxxxx
GOOGLE_CLOUD_SPEECH_API_KEY=xxxxx
GOOGLE_CALENDAR_API_KEY=xxxxx
GOOGLE_MEET_API_KEY=xxxxx

# --- Gemini ---
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# --- Meeting / CORS ---
MEETING_SERVER_URL=http://meeting-server:3020
MEETING_PUBLIC_URL=http://127.0.0.1:3020
PATIENT_PORTAL_URL=http://127.0.0.1:3005
DOCTOR_PORTAL_URL=http://127.0.0.1:3010
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3020,http://127.0.0.1:3005,http://127.0.0.1:3010,http://127.0.0.1:3020

# Doctor must click Admit in lobby (E2E gate sets VITE_AUTO_ADMIT_LOBBY=1 at runtime)
VITE_AUTO_ADMIT_LOBBY=0

# --- Jitsi ---
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine

# --- Security ---
JWT_SECRET=xxxxx
JWT_EXPIRES_IN=3h
SESSION_EXPIRES_IN=7d
RECORDING_ENCRYPTION_KEY=xxxxx
JIBRI_WEBHOOK_SECRET=xxxxx

# --- Ops ---
E2E_ALLOW_PARALLEL_SESSIONS=1
RATE_LIMIT_MAX=2000

# --- Demo automation (local/docker E2E — no manual login/join clicks) ---
DEMO_AUTO_LOGIN=1
DEMO_AUTO_MEETING=1
DEMO_PATIENT_EMAIL=demo.test@gmail.com
DEMO_PATIENT_PASSWORD=xxxxx
DEMO_DOCTOR_EMAIL=doctor.test@izara.com
DEMO_DOCTOR_PASSWORD=xxxxx
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_JWT_SECRET=xxxxx

JWT_SECRET=xxxxx
PATIENT_PORTAL_URL=http://127.0.0.1:3005
DOCTOR_PORTAL_URL=http://127.0.0.1:3010
MEETING_URL=http://127.0.0.1:3020
