# ============================================================================
# IZARA TELEMEDICINE - DOCKER COMPOSE ENVIRONMENT (EXAMPLE)
# Version: 3.1.0
# Updated: 2026-01-27
# ============================================================================
# Copy this file to .env.docker and replace with your actual API keys
# DO NOT commit .env.docker with real API keys to version control!
# ============================================================================

# ============================================================================
# POSTGRES DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# ============================================================================
# GOOGLE APIs - REPLACE WITH YOUR OWN KEYS
# ============================================================================
# Get your API keys from: https://console.cloud.google.com/apis/credentials

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID

# Google Calendar & Meet API
VITE_GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_CALENDAR_API_KEY
VITE_GOOGLE_MEET_API_KEY=YOUR_GOOGLE_MEET_API_KEY

# Google Cloud Speech-to-Text API
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
VITE_GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# LLM Models
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ============================================================================
# JITSI CONFIGURATION
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
VITE_JITSI_APP_ID=izara-telemedicine
VITE_JITSI_ENABLE_LOBBY=true
VITE_JITSI_ENABLE_PREJOIN=true

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-secure-jwt-secret-key-change-this
JWT_EXPIRES_IN=30m
SESSION_EXPIRES_IN=7d

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_USE_POSTGRESQL=true
USE_POSTGRESQL=true
