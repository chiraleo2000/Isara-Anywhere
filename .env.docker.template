# ============================================================================
# IZARA TELEMEDICINE — Docker Compose Environment TEMPLATE
# Version: 3.6.0
# ============================================================================
# Copy this file to .env.docker and replace placeholders with real values.
# .env.docker is gitignored — NEVER commit real API keys.
# Structure mirrors .env.docker.example (single source of truth for keys).
# Run: docker compose --env-file .env.docker up -d --build
# ============================================================================

# ============================================================================
# POSTGRES DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword

# ============================================================================
# GOOGLE CLOUD PLATFORM
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# ============================================================================
# GOOGLE APIs — REPLACE WITH YOUR OWN KEYS
# Get keys from: https://console.cloud.google.com/apis/credentials
# ============================================================================
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
VITE_GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_CALENDAR_API_KEY
VITE_GOOGLE_MEET_API_KEY=YOUR_GOOGLE_MEET_API_KEY
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
VITE_GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY

# ============================================================================
# GEMINI AI — xxxxx = AI disabled until you add a real key
# Get your key: https://aistudio.google.com/app/apikey
# ============================================================================
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ============================================================================
# MEETING SERVER
# ============================================================================
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=http://localhost:3020
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3011

# ============================================================================
# JITSI CONFIGURATION (FREE — no API key needed)
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your-secure-jwt-secret-key-change-this
RECORDING_ENCRYPTION_KEY=your-recording-encryption-key-min-32-chars
JIBRI_WEBHOOK_SECRET=your-jibri-webhook-secret

# ============================================================================
# DATABASE FLAGS
# ============================================================================
USE_POSTGRESQL=true
