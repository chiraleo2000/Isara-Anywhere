# ============================================================================
# Izara Patient Portal - Environment Configuration TEMPLATE
# Copy this file to .env and fill in your actual values
# ============================================================================
# APPLICATION INFO
# ============================================================================
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development
VITE_PHASE=Phase1

# GCP Configuration
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1
GCP_PROJECT_ID=your-gcp-project-id

# OAuth (for Google Sign-In and GCS access)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_OAUTH_REDIRECT_URI=http://localhost:3004/auth/callback
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
VITE_API_URL=http://localhost:3005
VITE_AUTH_PORTAL_URL=http://localhost:3005/auth
VITE_PATIENT_URL=http://localhost:3005/home
VITE_WEBSOCKET_URL=ws://localhost:3005/ws

# ============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================================
POSTGRES_PASSWORD=your-db-password
POSTGRES_USER=postgres
POSTGRES_DB=izara_phase1
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5433/izara_phase1
DB_HOST=localhost
DB_PORT=5433
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=your-db-password
USE_POSTGRESQL=true

# ============================================================================
# GOOGLE APIS
# ============================================================================
VITE_GOOGLE_CALENDAR_API_KEY=your-google-api-key
VITE_GOOGLE_MEET_API_KEY=your-google-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_SECRET=your-google-maps-secret
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id

# Google Cloud Speech-to-Text API
VITE_GOOGLE_SPEECH_API_KEY=your-google-api-key
GOOGLE_SPEECH_API_KEY=your-google-api-key

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# LLM Models
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# Embedding Model
VITE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VITE_EMBEDDING_DIMENSIONS=768
VITE_EMBEDDING_BATCH_SIZE=100

# Generation Settings
VITE_GEMINI_TEMPERATURE=0.3
VITE_GEMINI_MAX_TOKENS=8192
VITE_GEMINI_TOP_P=0.95
VITE_GEMINI_TOP_K=40

# Vector Store Configuration (PostgreSQL pgvector)
VITE_ENABLE_VECTOR_STORE=true
VITE_VECTOR_SIMILARITY_THRESHOLD=0.75
VITE_VECTOR_TOP_K=10

# RAG & Knowledge Base Configuration
VITE_ENABLE_RAG=true
VITE_RAG_CHUNK_SIZE=512
VITE_RAG_CHUNK_OVERLAP=50
VITE_KNOWLEDGE_BASE_ENABLED=true
VITE_CHAT_HISTORY_ENABLED=true
VITE_CHAT_HISTORY_MAX_MESSAGES=50

# Context Caching
VITE_ENABLE_CONTEXT_CACHE=true
VITE_CONTEXT_CACHE_TTL=3600

# ============================================================================
# SPEECH-TO-TEXT CONFIGURATION
# ============================================================================
VITE_STT_PROVIDER=web-speech-api
VITE_STT_LANGUAGE=th-TH
VITE_STT_CONTINUOUS=true
VITE_STT_INTERIM_RESULTS=true

VITE_GOOGLE_STT_ENABLED=true
VITE_GOOGLE_STT_API_KEY=your-google-api-key
GOOGLE_CLOUD_SPEECH_API_KEY=your-google-api-key
VITE_GOOGLE_STT_MODEL=latest_long
VITE_GOOGLE_STT_SAMPLE_RATE=16000
VITE_GOOGLE_STT_ENCODING=LINEAR16
VITE_GOOGLE_STT_ENABLE_WORD_TIME_OFFSETS=true
VITE_GOOGLE_STT_ENABLE_AUTOMATIC_PUNCTUATION=true
VITE_GOOGLE_STT_STREAMING_ENABLED=true
VITE_GOOGLE_STT_STREAMING_TIMEOUT=300

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_AI=true
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_AI_SUMMARY=true
VITE_ENABLE_VIDEO=true
VITE_ENABLE_TRANSCRIPTION=true
VITE_ENABLE_MAP=true
VITE_ENABLE_PDPA=true
VITE_ENABLE_LIVING_WILL=true
VITE_ENABLE_TIMELINE=true
VITE_USE_POSTGRESQL=true
VITE_USE_GCS=false

# PDPA Compliance
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_AUDIT_LOGGING_ENABLED=true

# EMR/EHR Features
VITE_EMR_PATIENT_ACCESS_CONTROL=true
VITE_EMR_AUTO_SAVE_INTERVAL=30000
VITE_EMR_VERSION_CONTROL=true

# Clinical Features
VITE_E_PRESCRIBING_ENABLED=true
VITE_DRUG_INTERACTION_CHECK=true
VITE_LAB_ORDERING_ENABLED=true
VITE_IMAGING_ORDERING_ENABLED=true

# AI Features
VITE_AI_CLINICAL_ASSIST=true
VITE_AI_VOICE_TRANSCRIPTION=true
VITE_AI_NOTE_SUMMARIZATION=true
VITE_AI_ICD_CODING_ASSIST=true
VITE_AI_DRUG_INFO=true
VITE_AI_DOCUMENT_ANALYSIS=true
VITE_AI_CDS_ENABLED=true
VITE_AI_MAN_IN_LOOP=true

# Other Features
VITE_LIVING_WILL_ENABLED=true
VITE_PHR_WEARABLES_ENABLED=true
VITE_VIDEO_CONSULTATION_ENABLED=true
VITE_QUEUE_MANAGEMENT_ENABLED=true
VITE_REAL_TIME_UPDATES=true

# ============================================================================
# VIDEO MEETING - JITSI MEET (FREE)
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
VITE_JITSI_APP_ID=izara-telemedicine
VITE_JITSI_ENABLE_LOBBY=true
VITE_JITSI_ENABLE_PREJOIN=true

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3004
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=3h
SESSION_EXPIRES_IN=7d

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
VITE_SESSION_TIMEOUT=1800000
VITE_MFA_ENABLED=false
VITE_ENCRYPTION_ENABLED=true

# ============================================================================
# MOBILE/PWA SETTINGS
# ============================================================================
VITE_PWA_ENABLED=true
VITE_OFFLINE_MODE_ENABLED=true

# ============================================================================
# TEST CREDENTIALS (for Playwright UI tests)
# ============================================================================
# TEST_PATIENT_PASSWORD=your-test-patient-password
# TEST_DOCTOR_PASSWORD=your-test-doctor-password
# IZARA_DOCTOR_PASSWORD=your-doctor-password
# IZARA_ADMIN_PASSWORD=your-admin-password
# IZARA_PATIENT_PASSWORD=your-patient-password
