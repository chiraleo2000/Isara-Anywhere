# ============================================================================
# IZARA TELEMEDICINE - ROOT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# These values are used by docker-compose.yml for all services
# ============================================================================

# ======================
# DATABASE CONFIGURATION
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd
POSTGRES_DB=izara_phase1

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=IzaraAdmin@2024

# ======================
# GOOGLE CLOUD SERVICES
# ======================

# Google Maps API Key (for healthcare map feature)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCjs3ang2xXSlE7o34QBEsG-GNhGrvxcHI
VITE_GOOGLE_MAPS_MAP_ID=60687d30be2fe4b7e600b274

# Google Gemini AI API Key (for AI chat, CDS, and meeting summaries)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Speech-to-Text (optional - uses Web Speech API as fallback)
# Leave empty to use browser-based Web Speech API (free)
GOOGLE_CLOUD_SPEECH_API_KEY=

# Google Calendar API (for appointment sync)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_API_KEY=

# ======================
# JWT AUTHENTICATION
# ======================
JWT_SECRET=izara-telemedicine-jwt-secret-2024
JWT_EXPIRES_IN=7d

# ======================
# JITSI CONFIGURATION
# ======================
# Use public Jitsi server (meet.jit.si) or your own self-hosted Jitsi
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_SECRET=

# ======================
# EMAIL CONFIGURATION
# ======================
# For appointment notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@izara-telemedicine.com

# ======================
# NOTIFICATION SERVICES
# ======================
# Firebase Cloud Messaging (for push notifications)
FCM_API_KEY=
FCM_PROJECT_ID=

# Line Notify (for Line notifications in Thailand)
LINE_NOTIFY_TOKEN=

# ======================
# EXTERNAL SERVICES
# ======================
# Thai National Drug Database API
THAI_FDA_API_KEY=

# ICD-10 Thailand API
ICD10_API_KEY=

# ======================
# APPLICATION SETTINGS
# ======================
# Demo mode (set to true for cloud deployments without database)
DEMO_MODE=false

# Use PostgreSQL (always true for local Docker)
USE_POSTGRESQL=true

# Use Google Cloud Storage (set to false for PostgreSQL-only)
USE_GCS=false

# Default language (th = Thai, en = English)
DEFAULT_LANGUAGE=th

# ======================
# CORS CONFIGURATION
# ======================
# Origins allowed for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3005,http://localhost:3010,http://localhost:3020

# ======================
# SERVICE PORTS
# ======================
PATIENT_PORTAL_PORT=3005
DOCTOR_PORTAL_PORT=3010
MEETING_SERVER_PORT=3020
POSTGRES_PORT=5433
PGADMIN_PORT=5050
