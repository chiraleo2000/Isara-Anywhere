# Isara Anywhere — environment setup
#
# 1. Docker (canonical secrets):
#      cp .env.docker.example .env.docker    # or .env.docker.lan*.example for Ubuntu LAN
#      npm run env:sync
#
# 2. Portal .env files are GENERATED — do not edit by hand:
#      Isara-patient-portal/.env
#      Isara-doctor-portal/.env
#      Izara-jitsi-server/.env
#      .env  (root — Vitest / Playwright)
#
# Guide: docs/ENV_SETUP.md | deploy/nginx/DEPLOYMENT.md
