# =============================================================================
# IZARA Docker Compose - Environment Variables
# =============================================================================
# วิธีใช้:
#   cp .env.example .env
#   แก้ SERVER_IP เป็น IP ของเครื่อง server จริง
#   แก้ API keys ที่จำเป็น (GEMINI_API_KEY ถ้าต้องการใช้ AI)
#   แล้วรัน: ./deploy.sh
# =============================================================================

# =============================================================================
# SERVER IP — แก้ตรงนี้เป็น IP ของเครื่อง server ที่ deploy
# =============================================================================
SERVER_IP=192.168.10.239

# =============================================================================
# DATABASE — ใช้ PostgreSQL ที่มีอยู่แล้วบน server
# =============================================================================
DB_HOST=izara-postgres
DB_INTERNAL_PORT=5432
DB_NAME=izara_phase1
DB_USER=
DB_PASSWORD=


# =============================================================================
# JWT (shared across all services)
# =============================================================================
JWT_SECRET=izara-jwt-secret-key-phase1-2026

# =============================================================================
# JITSI MEET
# =============================================================================
JITSI_DOMAIN=meet.demotoday.net
JITSI_XMPP_DOMAIN=meet.jitsi
JITSI_APP_ID=izara-telemedicine
JITSI_JWT_SECRET=21toTKg9Q7auYZF6h0wXd4Y0nBfj4T40zCA9DdHTSm4=
JITSI_JWT_AUDIENCE=izara-telemedicine
JITSI_JWT_ISSUER=izara-telemedicine
JIBRI_WEBHOOK_SECRET=izara-jibri-webhook-secret-2026
RECORDING_ENCRYPTION_KEY=izara-recording-encryption-key-2026

# =============================================================================
# GCP / OAUTH
# =============================================================================
GCP_PROJECT_ID=izara-telemedicine
GCP_REGION=asia-southeast1
GOOGLE_CLIENT_ID=724889190329-svf2733fjqklfic9tet9d2qkmhkgmu0l.apps.googleusercontent.com

# =============================================================================
# GOOGLE APIs (ใส่ถ้ามี — ไม่ใส่ก็ start ได้ แต่ feature นั้นจะไม่ทำงาน)
# =============================================================================
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_SPEECH_API_KEY=
GOOGLE_STT_ENABLED=true

# =============================================================================
# GEMINI AI (ใส่ถ้าต้องการ AI features)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# =============================================================================
# OPENAI / WHISPER (ใส่ถ้าต้องการ post-meeting transcription pipeline)
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# SMTP EMAIL (Doctor Portal ใช้ส่ง appointment confirmation/decline emails)
# Provider: gmail | mailtrap | sendgrid | (เว้นว่างสำหรับ custom SMTP)
# ถ้าไม่ตั้ง → simulation mode (log แต่ไม่ส่งจริง)
# =============================================================================
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@izara.com
SMTP_FROM_NAME=Izara Telemedicine

# =============================================================================
# ADMIN / NOTIFICATIONS
# =============================================================================
ADMIN_EMAIL=admin@izara.com

# =============================================================================
# FILE STORAGE — host path ที่จะ bind mount เข้า container
# ตั้งค่าตาม path จริงบน server ที่ต้องการเก็บไฟล์
# =============================================================================
# Jitsi recordings (issara-jitsi) — bind mount host path → container /app/recordings
RECORDINGS_DIR=/resources/recordings
# Doctor uploads (issara-doctor) — bind mount host path → container /app/uploads
UPLOADS_DIR=/resources/uploads

# =============================================================================
# PUBLIC URLs — Browser จะเรียก URLs เหล่านี้
# deploy.sh จะ auto-replace localhost → SERVER_IP ให้
# แต่ถ้าอยากตั้งเองก็แก้ได้ตรงนี้
# =============================================================================
PATIENT_API_URL=https://patient.demotoday.net
DOCTOR_API_URL=https://doctor.demotoday.net
DOCTOR_AUTH_URL=https://doctor.demotoday.net/auth
DOCTOR_WS_URL=https://doctor.demotoday.net/ws
MEETING_SERVER_URL=https://meeting.demotoday.net
