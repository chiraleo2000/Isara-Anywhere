# Isara Telemedicine Platform - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=izara_phase1

# Database connection URL (used by docker-compose)
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@localhost:5432/izara_phase1

# Individual database settings (used by local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Vite frontend database settings (for type info only - actual connection via backend)
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=izara_phase1
VITE_DB_USER=postgres
VITE_DB_PASSWORD=your_secure_postgres_password_here

# ============================================
# pgAdmin Configuration
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# ============================================
# Google Cloud APIs
# ============================================
# Google Gemini AI API Key (for AI Clinical Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GEMINI_MODEL=gemini-2.5-flash-lite

# Google Maps API Key (for location services)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Speech-to-Text API Key
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# ============================================
# Jitsi Video Conferencing (Free - No Key Needed)
# ============================================
VITE_JITSI_DOMAIN=meet.jit.si

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=3005
VITE_USE_POSTGRESQL=true
VITE_USE_GCS=true

# ============================================
# Note: GOOGLE_APPLICATION_CREDENTIALS
# ============================================
# The Google service account JSON file path is configured in docker-compose.yml
# Place your service account JSON file in the ./credentials directory
