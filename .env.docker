# ============================================================================
# IZARA TELEMEDICINE - DOCKER ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains all environment variables for Docker Compose
# Copy to .env in the project root to use with docker-compose
#
# Usage: docker-compose --env-file .env.docker up --build
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd
POSTGRES_DB=izara_phase1
DB_HOST=postgres
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=P@ssw0rd
DATABASE_URL=postgresql://postgres:P@ssw0rd@postgres:5432/izara_phase1

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NODE_ENV=production
USE_POSTGRESQL=true
USE_GCS=false

# ============================================================================
# GCP CONFIGURATION
# ============================================================================
GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_PROJECT_ID=izara-telemedicine
VITE_GCP_REGION=asia-southeast1

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
VITE_GOOGLE_CLIENT_ID=724889190329-svf2733fjqklfic9tet9d2qkmhkgmu0l.apps.googleusercontent.com

# ============================================================================
# GCS BUCKETS (for fallback/migration only)
# ============================================================================
GCS_BUCKET_AUTH=izara-users-credentials
GCS_BUCKET_PATIENT=izara-patients-data
GCS_BUCKET_DOCTOR=izara-doctors-data
GCS_BUCKET_APPOINTMENTS=izara-appointments
GCS_BUCKET_METADATA=izara-meta-data

# ============================================================================
# GOOGLE APIS (Replace with your actual keys from .env files)
# ============================================================================
GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY:-}
VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY:-}
VITE_GOOGLE_MAPS_MAP_ID=60687d30be2fe4b7e600b274
GOOGLE_SPEECH_API_KEY=${VITE_GOOGLE_SPEECH_API_KEY:-}
VITE_GOOGLE_SPEECH_API_KEY=${VITE_GOOGLE_SPEECH_API_KEY:-}

# ============================================================================
# GEMINI AI CONFIGURATION
# ============================================================================
GEMINI_API_KEY=${VITE_GEMINI_API_KEY:-}
VITE_GEMINI_API_KEY=${VITE_GEMINI_API_KEY:-}
GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# JITSI CONFIGURATION
# ============================================================================
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si

# ============================================================================
# PGADMIN CONFIGURATION
# ============================================================================
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=IzaraAdmin@2024
