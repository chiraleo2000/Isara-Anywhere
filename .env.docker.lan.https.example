# ============================================================================
# IZARA — Docker Compose + Nginx LAN + HTTPS (EXAMPLE)
# ============================================================================
# Mode B with TLS on Ubuntu (mkcert or internal CA for *.isara.local).
#
#   cp .env.docker.lan.https.example .env.docker
#   # edit secrets and API keys
#   docker compose --env-file .env.docker up -d --build
#
# Nginx: deploy/nginx/isara-nginx.conf (see deploy/nginx/DEPLOYMENT.md)
# Guide: deploy/nginx/DEPLOYMENT.md
# ============================================================================

# --- Application ---
VITE_APP_NAME=Izara Patient Portal
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production
NODE_ENV=production

# --- Database ---
# Persist Postgres on the Ubuntu host (create dir first: sudo mkdir -p /var/lib/izara/postgres && sudo chown 999:999 /var/lib/izara/postgres)
POSTGRES_DATA_DIR=/var/lib/izara/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePassword
POSTGRES_DB=izara_phase1
POSTGRES_PUBLISH=5433
PGADMIN_DEFAULT_EMAIL=admin@izara.com
PGADMIN_DEFAULT_PASSWORD=YourSecurePgAdminPassword
DATABASE_URL=postgresql://postgres:YourSecurePassword@postgres:5432/izara_phase1
DB_HOST=postgres
DB_PORT=5432
DB_NAME=izara_phase1
DB_USER=postgres
DB_PASSWORD=YourSecurePassword
DB_SSL=false
USE_POSTGRESQL=true

# --- Security ---
JWT_SECRET=replace-with-openssl-rand-hex-32-min-32-chars
JWT_EXPIRES_IN=3h
SESSION_EXPIRES_IN=7d
RECORDING_ENCRYPTION_KEY=replace-with-32-char-minimum-secret-key
JIBRI_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_GCP_REGION=asia-southeast1

# --- OAuth (add https redirect URIs in Google Cloud Console) ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
VITE_OAUTH_REDIRECT_URI=https://patient.isara.local/auth/callback

# --- Browser URLs (HTTPS — must match Nginx server_name + TLS) ---
VITE_API_URL=
VITE_AUTH_PORTAL_URL=https://patient.isara.local/auth
VITE_PATIENT_URL=https://patient.isara.local/home
VITE_WEBSOCKET_URL=wss://patient.isara.local/ws
VITE_AUTH_URL=

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
VITE_GOOGLE_CALENDAR_API_KEY=YOUR_GOOGLE_API_KEY
VITE_GOOGLE_MEET_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_CLOUD_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY
VITE_GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_API_KEY

# --- Gemini (xxxxx = disabled) ---
GEMINI_API_KEY=xxxxx
VITE_GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# --- Meeting (internal Docker vs browser HTTPS) ---
MEETING_SERVER_URL=http://meeting-server:3020
VITE_MEETING_SERVER_URL=https://meeting.isara.local

# CORS — https LAN origins (shared/corsPolicy.cjs also allows https://*.isara.local)
CORS_ORIGINS=https://patient.isara.local,https://doctor.isara.local,https://meeting.isara.local,https://dbadmin.isara.local,http://localhost:3005,http://localhost:3010,http://localhost:3020

# --- Jitsi ---
JITSI_DOMAIN=meet.jit.si
VITE_JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=izara-telemedicine
VITE_JITSI_APP_ID=izara-telemedicine

# --- Feature flags (build-time Vite) ---
VITE_PDPA_ENABLED=true
VITE_CONSENT_REQUIRED=true
VITE_AUDIT_LOGGING_ENABLED=true
VITE_VIDEO_CONSULTATION_ENABLED=true
VITE_REAL_TIME_UPDATES=true

# --- Ops ---
E2E_ALLOW_PARALLEL_SESSIONS=1
RATE_LIMIT_MAX=2000
